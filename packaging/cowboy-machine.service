[Unit]
Description=Cowboy Machine host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cowboy-machine-launch
Restart=on-failure
RestartSec=2
SuccessExitStatus=75
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/cowboy-machine %t/cowboy

[Install]
WantedBy=default.target
