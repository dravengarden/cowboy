{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "lock": "deno.lock",
  "nodeModulesDir": "manual",
  "imports": {
    "@emotion/react": "npm:@emotion/react@^11.13.0",
    "@emotion/styled": "npm:@emotion/styled@^11.13.0",
    "@mui/icons-material/": "npm:@mui/icons-material@^7.0.0/",
    "@mui/material": "npm:@mui/material@^7.0.0",
    "@mui/material/": "npm:@mui/material@^7.0.0/",
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0"
  },
  "tasks": {
    "install": "deno install",
    "dev": "node node_modules/.bin/vite",
    "build": "node node_modules/.bin/tsc --noEmit && node node_modules/.bin/vite build",
    "preview": "node node_modules/.bin/vite preview",
    "typecheck": "node node_modules/.bin/tsc --noEmit",
    "lint": "node_modules/.bin/oxlint --ignore-pattern public/wasm_exec.js",
    "test": "deno test --no-check --sloppy-imports --allow-read --allow-env=NODE_ENV src/"
  }
}
