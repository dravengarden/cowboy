--- a/src/__tests__/scenarios/baseline.ts
+++ b/src/__tests__/scenarios/baseline.ts
@@ -246,7 +246,14 @@ export function expectedFromBaseline(scenario: string, baseline: RecordedMessage
     return withFeatureChanges(withBugFixes(scenario, withoutAirOnlyMessages(baseline))).flatMap(message =>
         message.method === "_auth/status_update"
             ? [message, {direction: "notify", method: "auth/status_update", params: {state: "not_required"}}]
-            : [message]);
+            : [message]).map(message => {
+        if (message.direction !== "response" || message.method !== "initialize") return message;
+        const params = structuredClone(message.params) as Json;
+        const meta = params["_meta"] as Json;
+        // Cowboy advertises its opt-in refusal to create a detached turn.
+        meta["steering"] = {...meta["steering"] as Json, idleBehavior: "promptRequired"};
+        return {...message, params};
+    });
 }
 
