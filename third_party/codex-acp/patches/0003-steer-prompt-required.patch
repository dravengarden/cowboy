@@ -85,6 +85,67 @@ describe('_session/steering', () => {
         await expect(promptPromise).resolves.toMatchObject({stopReason: "end_turn"});
     });
 
+    it('returns idle admission to the host when requested', async () => {
+        const fixture = createCodexMockTestFixture();
+        vi.spyOn(fixture.getCodexAcpAgent(), "getSessionState").mockReturnValue(createTestSessionState());
+        const start = vi.spyOn(fixture.getCodexAppServerClient(), "turnStart");
+        const steer = vi.spyOn(fixture.getCodexAppServerClient(), "turnSteer");
+        await expect(fixture.getCodexAcpAgent().extMethod(SESSION_STEERING_METHOD, {
+            sessionId: "session-id",
+            prompt: [{type: "text", text: "preserve the host queue"}],
+            _meta: {steering: {idleBehavior: "promptRequired"}},
+        })).resolves.toEqual({outcome: "promptRequired", reason: "noRunningTurn"});
+        expect(start).not.toHaveBeenCalled();
+        expect(steer).not.toHaveBeenCalled();
+    });
+
+    it('does not start a detached turn when an opted-in injection races completion', async () => {
+        const {mockFixture, sessionState, turnCompleted} = startActiveTurn();
+        const start = vi.spyOn(mockFixture.getCodexAppServerClient(), "turnStart");
+        vi.spyOn(mockFixture.getCodexAppServerClient(), "turnSteer").mockImplementation(async () => {
+            turnCompleted.resolve({threadId: "session-id", turn: createTurn("turn-id", "completed")});
+            throw Object.assign(new Error("Internal error"), {data: {details: "no active turn to steer"}});
+        });
+        const prompt = mockFixture.getCodexAcpAgent().prompt({
+            sessionId: "session-id", prompt: [{type: "text", text: "running"}],
+        });
+        await vi.waitFor(() => expect(sessionState.currentTurnId).toBe("turn-id"));
+        await expect(mockFixture.getCodexAcpAgent().extMethod(SESSION_STEERING_METHOD, {
+            sessionId: "session-id", prompt: [{type: "text", text: "late"}],
+            _meta: {steering: {idleBehavior: "promptRequired"}},
+        })).resolves.toEqual({outcome: "promptRequired", reason: "noRunningTurn"});
+        await expect(prompt).resolves.toMatchObject({stopReason: "end_turn"});
+        expect(start).toHaveBeenCalledTimes(1);
+    });
+
+    it('rejects unknown idle delivery rather than silently starting a turn', async () => {
+        const fixture = createCodexMockTestFixture();
+        await expect(fixture.getCodexAcpAgent().extMethod(SESSION_STEERING_METHOD, {
+            sessionId: "session-id", prompt: [{type: "text", text: "late"}],
+            _meta: {steering: {idleBehavior: "nextToolCall"}},
+        })).rejects.toThrow(RequestError);
+    });
+
+    it('does not make an ambiguous reply safe to replay merely because the turn ended', async () => {
+        const {mockFixture, sessionState, turnCompleted} = startActiveTurn();
+        const start = vi.spyOn(mockFixture.getCodexAppServerClient(), "turnStart");
+        vi.spyOn(mockFixture.getCodexAppServerClient(), "turnSteer").mockImplementation(async () => {
+            turnCompleted.resolve({threadId: "session-id", turn: createTurn("turn-id", "completed")});
+            sessionState.currentTurnId = null;
+            throw new Error("response connection lost after possible injection");
+        });
+        const prompt = mockFixture.getCodexAcpAgent().prompt({
+            sessionId: "session-id", prompt: [{type: "text", text: "running"}],
+        });
+        await vi.waitFor(() => expect(sessionState.currentTurnId).toBe("turn-id"));
+        await expect(mockFixture.getCodexAcpAgent().extMethod(SESSION_STEERING_METHOD, {
+            sessionId: "session-id", prompt: [{type: "text", text: "uncertain"}],
+            _meta: {steering: {idleBehavior: "promptRequired"}},
+        })).resolves.toEqual({outcome: "failed"});
+        await prompt;
+        expect(start).toHaveBeenCalledTimes(1);
+    });
+
     it('starts a new turn when no turn is active', async () => {
         const mockFixture = createCodexMockTestFixture();
         const sessionState = createTestSessionState();
