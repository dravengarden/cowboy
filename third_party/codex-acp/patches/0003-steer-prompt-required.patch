From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Draven <dravengarden@gmail.com>
Date: Wed, 18 Nov 2026 01:04:42 +0000
Subject: [PATCH] Advertise promptRequired steering and refuse ambiguous steer
 replays

Cowboy admits current-turn steering only when the agent advertises
`idleBehavior: "promptRequired"` in initialize. Upstream parses the
request opt-in but does not advertise it. A host that opted in may
replay only an explicit native no-active-turn refusal, never an
ambiguous transport error after the turn ended.

Cowboy-Delta: steer-prompt-required
Upstream: not-proposed
Drop-When: upstream advertises idleBehavior promptRequired and refuses ambiguous steer errors for opted-in hosts
Tests: src/__tests__/CodexACPAgent/steer-events.test.ts src/__tests__/CodexACPAgent/initialize.test.ts

diff --git a/src/CodexAcpServer.ts b/src/CodexAcpServer.ts
index a330aec802bf1a3b6c093141bc44b5d70e5b971f..1b2f01dda136316b70008ce58d83db7741656a22 100644
--- a/src/CodexAcpServer.ts
+++ b/src/CodexAcpServer.ts
@@ -955,6 +955,7 @@ export class CodexAcpServer {
         return {
             steering: {
                 supported: true,
+                idleBehavior: "promptRequired",
             },
             ...(this.capabilities.airClient ? {
                 [JETBRAINS_META_KEY]: {
@@ -3117,6 +3118,8 @@ export class CodexAcpServer {
                 return {outcome: "injected"};
             }
         }
+        // Opt-in host-owned admission: a late steer must not create an
+        // unobserved turn or bypass a paused host queue.
         if (params._meta?.steering?.idleBehavior === "promptRequired") {
             return {outcome: "promptRequired", reason: "noRunningTurn"};
         }
@@ -3167,7 +3170,11 @@ export class CodexAcpServer {
             await this.codexAcpClient.waitForSessionNotifications(params.sessionId);
             const turnStillActive = sessionState.currentTurnId !== null
                 && codexRunningTurnId(sessionState, sessionState.currentTurnId) === turnId;
-            if (turnStillActive && !this.isNoActiveTurnToSteerError(err)) {
+            // An ended turn does not prove that a lost reply preceded delivery.
+            // Hosts opting into queue ownership may replay only an explicit
+            // native no-active-turn refusal, never an ambiguous transport error.
+            if ((turnStillActive || params._meta?.steering?.idleBehavior === "promptRequired") &&
+                !this.isNoActiveTurnToSteerError(err)) {
                 throw err;
             }
             return false;
