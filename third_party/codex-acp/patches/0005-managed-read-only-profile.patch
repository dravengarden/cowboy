@@ -0,0 +1,44 @@
+import {afterEach, describe, expect, it, vi} from "vitest";
+import {createCodexMockTestFixture, createTestModel} from "./acp-test-utils";
+import {MANAGED_PROFILE, MANAGED_PROFILE_ENV} from "../CowboyManagedProfile";
+
+afterEach(() => {
+    delete process.env[MANAGED_PROFILE_ENV];
+    vi.unstubAllEnvs();
+});
+
+describe("Cowboy managed profile and permission profile modes", () => {
+    it("offers no configured permission profile and reads no project configuration", async () => {
+        vi.stubEnv("INITIAL_AGENT_MODE", undefined);
+        process.env[MANAGED_PROFILE_ENV] = MANAGED_PROFILE;
+        const fixture = createCodexMockTestFixture();
+        const codexAcpClient = fixture.getCodexAcpClient();
+        const appServer = fixture.getCodexAppServerClient();
+        vi.spyOn(codexAcpClient, "readAuthRequirement").mockResolvedValue({required: false, account: null});
+        vi.spyOn(codexAcpClient, "getAccount").mockResolvedValue({account: null, requiresOpenaiAuth: false});
+        vi.spyOn(appServer, "listSkills").mockResolvedValue({data: []});
+        const configRead = vi.spyOn(appServer, "configRead").mockResolvedValue({config: {}} as any);
+        const listProfiles = vi.spyOn(appServer, "listPermissionProfiles").mockResolvedValue({
+            data: [{id: "team-default", description: null, allowed: true}],
+            nextCursor: null,
+        });
+        const threadStart = vi.spyOn(appServer, "threadStart").mockResolvedValue({
+            thread: {id: "thread-id", turns: [], status: {type: "idle"}},
+            model: "gpt-5",
+            modelProvider: "openai",
+            reasoningEffort: "medium",
+            serviceTier: null,
+            approvalPolicy: "never",
+            approvalsReviewer: "user",
+        } as any);
+        vi.spyOn(appServer, "listModels").mockResolvedValue({data: [createTestModel({id: "gpt-5"})], nextCursor: null});
+
+        const session = await fixture.getCodexAcpAgent().newSession({cwd: "/workspace", mcpServers: []});
+
+        expect(listProfiles).not.toHaveBeenCalled();
+        expect(configRead).not.toHaveBeenCalled();
+        expect(threadStart.mock.calls[0]![0].config?.["projects"]).toBeUndefined();
+        expect(session.modes?.availableModes.map(mode => mode.id) ?? [])
+            .not.toContain("permission-profile:team-default");
+    });
+});
diff --git a/src/__tests__/CowboyManagedProfile.test.ts b/src/__tests__/CowboyManagedProfile.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..797fbf280aa3e9524abbdc2f01e9d17d6c93ddbe
--- /dev/null
+++ b/src/__tests__/CowboyManagedProfile.test.ts
@@ -0,0 +1,37 @@
+import {afterEach, describe, expect, it} from "vitest";
+import {
+    MANAGED_CALL_META_KEY,
+    MANAGED_PROFILE_ENV,
+    managedTurn,
+    refuseManagedReconfiguration,
+} from "../CowboyManagedProfile";
+
+const meta = (value: unknown) => ({[MANAGED_CALL_META_KEY]: value});
+
+describe("Cowboy managed read-only profile", () => {
+    afterEach(() => {
+        delete process.env[MANAGED_PROFILE_ENV];
+    });
+
+    it("leaves ordinary sessions untouched and refuses managed metadata there", () => {
+        expect(managedTurn(undefined)).toBeNull();
+        expect(managedTurn({other: true})).toBeNull();
+        expect(() => managedTurn(meta({callId: "c", inputRevision: "r", outputSchema: null})))
+            .toThrow(/requires the managed/);
+        expect(() => refuseManagedReconfiguration()).not.toThrow();
+    });
+
+    it("requires per-turn metadata and forwards the native output schema", () => {
+        process.env[MANAGED_PROFILE_ENV] = "read-only-v1";
+        expect(() => managedTurn(undefined)).toThrow(/missing/);
+        expect(() => managedTurn(meta({callId: "c"}))).toThrow(/invalid/);
+        expect(() => managedTurn(meta({callId: "c", inputRevision: "r", outputSchema: []})))
+            .toThrow(/invalid/);
+        const schema = {type: "object", properties: {verdict: {type: "string"}}};
+        expect(managedTurn(meta({callId: "c", inputRevision: "r", outputSchema: schema})))
+            .toEqual({callId: "c", outputSchema: schema});
+        expect(managedTurn(meta({callId: "c", inputRevision: "r", outputSchema: null})))
+            .toEqual({callId: "c", outputSchema: null});
+        expect(() => refuseManagedReconfiguration()).toThrow(/fixed/);
+    });
+});
