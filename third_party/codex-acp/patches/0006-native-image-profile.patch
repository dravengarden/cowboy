+    async requireImageGeneration(): Promise<void> {
+        const value = await this.connection.sendRequest("modelProvider/capabilities/read", {});
+        if (value === null || typeof value !== "object"
+            || (value as Record<string, unknown>)["imageGeneration"] !== true) {
+            throw new Error("native_image_generation_unavailable");
+        }
+        const {account} = await this.accountRead({refreshToken: false});
+        if (account?.type !== "chatgpt" || account.planType === "free") {
+            throw new Error("native_image_generation_requires_supported_chatgpt_account");
+        }
+    }
