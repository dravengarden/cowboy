--- /dev/null
+++ b/src/__tests__/CowboyNativeCodexVersion.test.ts
@@ -0,0 +1,23 @@
+import {readFileSync} from "node:fs";
+import {createRequire} from "node:module";
+import {describe, expect, it} from "vitest";
+
+// Cowboy packages native Codex 0.169.1 (the first release whose bundled model
+// catalog carries GPT-6.2). The adapter's declared range and the lockfile must
+// resolve to that release, so upstream's suites run against the native CLI
+// Cowboy ships.
+const require = createRequire(import.meta.url);
+const manifest = JSON.parse(readFileSync(new URL("../../package.json", import.meta.url), "utf8"));
+const lock = JSON.parse(readFileSync(new URL("../../package-lock.json", import.meta.url), "utf8"));
+
+describe("Cowboy native Codex declaration", () => {
+    it("declares the native Codex release Cowboy packages", () => {
+        expect(manifest.dependencies["@openai/codex"]).toBe("^0.169.1");
+        expect(lock.packages["node_modules/@openai/codex"].version).toBe("0.169.1");
+    });
+
+    it("installs the locked native Codex release", () => {
+        const installed = require("@openai/codex/package.json") as {version: string};
+        expect(installed.version).toBe("0.169.1");
+    });
+});
