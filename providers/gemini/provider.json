{
  "authoring_schema": 2,
  "id": "gemini",
  "version": "1.0.1",
  "publisher": "cowboy-first-party",
  "sdk_version": "2.2.0",
  "display": {
    "name": "Gemini",
    "vendor": "Google",
    "summary": "Gemini CLI with Google, API key, or Vertex authentication",
    "accent": "#4285F4",
    "secondary_accent": "#9B72CB",
    "mark_view_box": "0 0 24 24",
    "mark_path": "M12 24A14.304 14.304 0 0 0 0 12 14.304 14.304 0 0 0 12 0a14.304 14.304 0 0 0 12 12 14.304 14.304 0 0 0-12 12",
    "mark_gradient": {
      "x1_percent": 0,
      "y1_percent": 0,
      "x2_percent": 100,
      "y2_percent": 100,
      "stops": [
        { "offset_percent": 0, "color": "#4285F4" },
        { "offset_percent": 50, "color": "#9B72CB" },
        { "offset_percent": 100, "color": "#D96570" }
      ]
    }
  },
  "card_layout": "split_status",
  "activity": {
    "indicator": { "kind": "mark_pulse", "interval_ms": 1800 },
    "label": {
      "kind": "text",
      "value": { "source": "literal", "value": "Thinking…" },
      "effect": "shimmer"
    },
    "accessible_label": "Gemini is working"
  },
  "host": {
    "schema_version": 1,
    "conversation_compaction": {
      "aliases": ["compact", "compress", "summarise", "summarize"],
      "fallback_command": "compress"
    },
    "account_usage": { "provider": "gemini" },
    "features": []
  },
  "runtime": {
    "driver_schema": 1,
    "protocol": "agent-client-protocol-1.3",
    "entrypoint": "gemini",
    "behavior": {
      "schema_version": 1,
      "permission": "acp_session_mode_yolo_v1",
      "session": "portable_v1",
      "turn_end": "portable_v1",
      "configuration": "portable_v1",
      "default_preferences": {},
      "error_rules": [
        {
          "when": {
            "op": "contains",
            "value": "This client is no longer supported for Gemini Code Assist for individuals"
          },
          "user_detail": "Gemini CLI no longer supports Google Login for personal, Google AI Pro, or AI Ultra accounts. Use a Gemini API key, Code Assist Standard/Enterprise, or migrate to Antigravity."
        }
      ]
    },
    "arguments": ["--acp"],
    "environment": {},
    "remove_environment": [],
    "remove_environment_prefixes": ["GEMINI_", "GOOGLE_"],
    "dependencies": [
      {
        "id": "google-gemini-cli",
        "version": "0.55.1",
        "source": "https://registry.npmjs.org/@google/gemini-cli/-/gemini-cli-0.55.1.tgz",
        "integrity": "sha512-leEv91V7J3YWhZdXqYIj4nTl0hXl8oNos5aVR0whPCFqVbRvoFPTzaQOHdI2UIT1wGgp+XdCi4qUrFDnUFN7RQ==",
        "private": true
      }
    ],
    "platforms": [
      {
        "os": "linux",
        "architecture": "x86_64",
        "payload_digest": "",
        "launch_command": "gemini",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "gemini",
            "dependency": "google-gemini-cli",
            "command": "gemini"
          }
        ]
      },
      {
        "os": "macos",
        "architecture": "aarch64",
        "payload_digest": "",
        "launch_command": "gemini",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "gemini",
            "dependency": "google-gemini-cli",
            "command": "gemini"
          }
        ]
      }
    ],
    "required_capabilities": ["provider.runtime.v1"]
  },
  "authentication": {
    "schema_version": 1,
    "required": true,
    "portable_schema": "gemini-auth-v1",
    "projection_schema": "gemini-home-v1",
    "refresh": "compare_and_swap",
    "methods": [
      {
        "id": "api-key",
        "label": "Gemini API key",
        "flow": "secret_input",
        "executor": {
          "kind": "secret_input_v1",
          "bundle_key": "api_key",
          "verification_url": "https://aistudio.google.com/apikey"
        },
        "required_bundle_keys": ["api_key"]
      },
      {
        "id": "code-assist",
        "label": "Code Assist Standard / Enterprise",
        "flow": "browser_code",
        "executor": {
          "kind": "command_v1",
          "component": { "kind": "provider_cli", "slot": "gemini" },
          "arguments": [],
          "terminal": "pty",
          "challenge": "browser_code",
          "environment": { "NO_BROWSER": "true", "TERM": "dumb" },
          "preflight": [
            {
              "kind": "env_file_key_required_v1",
              "relative_path": ".gemini/.env",
              "key": "GOOGLE_CLOUD_PROJECT"
            },
            {
              "kind": "json_string_set_v1",
              "relative_path": ".gemini/settings.json",
              "path": ["security", "auth", "selectedType"],
              "value": "oauth-personal"
            }
          ]
        },
        "required_bundle_keys": ["settings_json", "oauth_creds_json"]
      }
    ],
    "credential_files": [
      {
        "bundle_key": "env",
        "relative_path": ".gemini/.env",
        "required": false
      },
      {
        "bundle_key": "settings_json",
        "relative_path": ".gemini/settings.json",
        "required": false
      },
      {
        "bundle_key": "oauth_creds_json",
        "relative_path": ".gemini/oauth_creds.json",
        "required": false
      }
    ],
    "environment_projection": { "GEMINI_API_KEY": "api_key" }
  },
  "compatibility": {
    "min_controller_contract": 2,
    "max_controller_contract": 2,
    "min_machine_contract": 4,
    "max_machine_contract": 4,
    "ui_component_fingerprint": "",
    "auth_contract_fingerprint": ""
  }
}
