{
  "authoring_schema": 2,
  "id": "codex-deepseek",
  "version": "1.0.0",
  "publisher": "cowboy-first-party",
  "sdk_version": "2.1.0",
  "display": {
    "name": "Codex · DeepSeek",
    "vendor": "DeepSeek",
    "summary": "Codex in an isolated DeepSeek runtime with V4 Flash and V4 Pro",
    "accent": "#4D6BFE",
    "secondary_accent": "#168B78",
    "mark_view_box": "0 0 24 24",
    "mark_path": "M12 2.25a4.2 4.2 0 0 1 4.05 3.1 4.2 4.2 0 0 1 2.7 6.65 4.2 4.2 0 0 1-2.7 6.65 4.2 4.2 0 0 1-8.1 0A4.2 4.2 0 0 1 5.25 12a4.2 4.2 0 0 1 2.7-6.65A4.2 4.2 0 0 1 12 2.25Zm0 4.15-4.85 2.8v5.6L12 17.6l4.85-2.8V9.2L12 6.4Z",
    "mark_fill": "#4D6BFE"
  },
  "card_layout": "split_status",
  "configuration_presets": [
    {
      "id": "deepseek-flash-max",
      "name": "Flash · Max",
      "detail": "DeepSeek-V4-Flash · Max reasoning",
      "is_default": true,
      "values": { "model": "deepseek-v4-flash", "reasoning_effort": "max" }
    }
  ],
  "configuration_options": [
    {
      "id": "deepseek_context",
      "order": 3,
      "layout": "full_width",
      "availability": "idle_or_stopped"
    },
    {
      "id": "deepseek_cache_protection",
      "order": 4,
      "layout": "full_width",
      "availability": "idle_or_stopped"
    }
  ],
  "host": {
    "schema_version": 1,
    "conversation_compaction": {
      "aliases": ["compact", "summarise", "summarize"],
      "fallback_command": "compact"
    },
    "account_usage": { "provider": "deepseek" },
    "features": ["cache_protection_v1"]
  },
  "runtime": {
    "driver_schema": 1,
    "protocol": "agent-client-protocol-1.3",
    "entrypoint": "codex-acp",
    "behavior": {
      "schema_version": 1,
      "permission": "acp_config_full_access_v1",
      "session": "portable_v1",
      "turn_end": "portable_v1",
      "configuration": "openai_gateway_v1",
      "default_preferences": {
        "model": "deepseek-v4-flash",
        "deepseek_context": "680k",
        "deepseek_cache_protection": true,
        "collaboration_mode": "default",
        "reasoning_effort": "max"
      },
      "error_rules": []
    },
    "arguments": [
      "-c",
      "model=\"deepseek-v4-flash\"",
      "-c",
      "model_provider=\"deepseek-local\"",
      "-c",
      "model_reasoning_effort=\"max\"",
      "-c",
      "approval_policy=\"never\"",
      "-c",
      "sandbox_mode=\"danger-full-access\"",
      "-c",
      "model_context_window=680000",
      "-c",
      "model_auto_compact_token_limit=646000",
      "-c",
      "model_auto_compact_token_limit_scope=\"body_after_prefix\"",
      "-c",
      "model_providers.deepseek-local.name=\"Isolated DeepSeek Responses gateway\"",
      "-c",
      {
        "source": "sidecar_url",
        "sidecar": "deepseek-gateway",
        "prefix": "model_providers.deepseek-local.base_url=\"",
        "suffix": "/v1\""
      },
      "-c",
      "model_providers.deepseek-local.wire_api=\"responses\"",
      "-c",
      "model_providers.deepseek-local.requires_openai_auth=false",
      "-c",
      "model_providers.deepseek-local.env_http_headers={\"X-Cowboy-Session-Id\"=\"COWBOY_DEEPSEEK_SESSION_ID\",\"X-Cowboy-Cache-Protection\"=\"COWBOY_DEEPSEEK_CACHE_PROTECTION\"}",
      "-c",
      "model_providers.deepseek-local.request_max_retries=1",
      "-c",
      "model_providers.deepseek-local.stream_max_retries=0",
      "-c",
      "model_providers.deepseek-local.stream_idle_timeout_ms=600000",
      "-c",
      "features.memories=true",
      "-c",
      "memories.disable_on_external_context=true",
      "-c",
      "memories.extract_model=\"deepseek-v4-flash\"",
      "-c",
      "memories.consolidation_model=\"deepseek-v4-flash\"",
      "-c",
      "memories.min_rate_limit_remaining_percent=0"
    ],
    "environment": { "MODEL_PROVIDER": "deepseek-local" },
    "sidecars": [
      {
        "id": "deepseek-gateway",
        "component": {
          "kind": "provider_gateway",
          "slot": "codex-deepseek"
        },
        "arguments": [],
        "environment": {},
        "auth_environment": ["DEEPSEEK_API_KEY"],
        "transport": {
          "kind": "loopback_http_v1",
          "listen_argument": "--listen",
          "health_path": "/healthz",
          "timeout_ms": 8000
        }
      }
    ],
    "remove_environment": [],
    "remove_environment_prefixes": [
      "CHATGPT_",
      "CODEX_",
      "DEEPSEEK_",
      "OPENAI_"
    ],
    "dependencies": [
      {
        "id": "codex-acp",
        "version": "1.1.7",
        "source": "https://registry.npmjs.org/@agentclientprotocol/codex-acp/-/codex-acp-1.1.7.tgz",
        "integrity": "sha512-bhFLbGtOMEw6+PAp33vNERb6dXlULOfV3mWbRdps4v7sY7PHha/C2T1dnlG0yVcvBu9W+NYPzL0CAupnVoFTiQ==",
        "private": true
      },
      {
        "id": "openai-codex",
        "version": "0.147.0",
        "source": "https://registry.npmjs.org/@openai/codex/-/codex-0.147.0.tgz",
        "integrity": "sha512-EQLEXecAG2ptxI7UpBMo2TR/ga5596/c/OsYF/0LoUDh5JANZ7IoGqlzBEWbuEVQ76JePIbtTW/ihCkp1a7Z3w==",
        "private": true
      },
      {
        "id": "codex-deepseek-gateway",
        "version": "0.2.0",
        "source": "git+ssh://git@github.com/dravengarden/columbus.git#6a83e9a9b2b4ac3239cf2c66c0821b1d3e43f781:projects/codex-deepseek",
        "integrity": "sha256:f9560a73932254ff98261bb44a0a87f4ee34aa4cb0310d83a01c234e7928a2c4",
        "private": true
      }
    ],
    "platforms": [
      {
        "os": "linux",
        "architecture": "x86_64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          },
          {
            "kind": "provider_gateway",
            "slot": "codex-deepseek",
            "dependency": "codex-deepseek-gateway",
            "command": "codex-deepseek-gateway"
          }
        ]
      },
      {
        "os": "linux",
        "architecture": "aarch64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          },
          {
            "kind": "provider_gateway",
            "slot": "codex-deepseek",
            "dependency": "codex-deepseek-gateway",
            "command": "codex-deepseek-gateway"
          }
        ]
      }
    ],
    "required_capabilities": ["provider.runtime.v1", "provider.gateway.v1"]
  },
  "authentication": {
    "schema_version": 1,
    "required": true,
    "portable_schema": "deepseek-api-key-v1",
    "projection_schema": "codex-deepseek-gateway-v1",
    "refresh": "service",
    "methods": [
      {
        "id": "api-key",
        "label": "DeepSeek API key",
        "flow": "secret_input",
        "executor": {
          "kind": "secret_input_v1",
          "bundle_key": "api_key",
          "verification_url": "https://platform.deepseek.com/api_keys"
        },
        "required_bundle_keys": ["api_key"]
      }
    ],
    "credential_files": [],
    "environment_projection": { "DEEPSEEK_API_KEY": "api_key" }
  },
  "compatibility": {
    "min_controller_contract": 2,
    "max_controller_contract": 2,
    "min_machine_contract": 4,
    "max_machine_contract": 4,
    "ui_component_fingerprint": "",
    "auth_contract_fingerprint": ""
  }
}
