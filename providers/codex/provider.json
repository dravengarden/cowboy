{
  "authoring_schema": 2,
  "id": "codex",
  "version": "1.1.0",
  "publisher": "cowboy-first-party",
  "sdk_version": "2.3.0",
  "display": {
    "name": "Codex",
    "vendor": "OpenAI",
    "summary": "Codex with its standard OpenAI account and configuration",
    "accent": "#4F6BED",
    "secondary_accent": "#168B78",
    "mark_view_box": "0 0 24 24",
    "mark_path": "M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z"
  },
  "card_layout": "mark_leading",
  "activity": {
    "indicator": { "kind": "terminal_prompt", "interval_ms": 4200 },
    "label": {
      "kind": "phrase_cycle",
      "phrases": [
        "Inspecting",
        "Searching",
        "Reasoning",
        "Editing",
        "Testing",
        "Reviewing",
        "Refining",
        "Verifying",
        "Working"
      ],
      "interval_ms": 4200,
      "suffix": "…",
      "effect": "shimmer"
    },
    "accessible_label": "Codex is working"
  },
  "configuration_presets": [
    {
      "id": "luna-max",
      "name": "Luna · Max",
      "detail": "GPT-5.6-Luna · Max reasoning",
      "is_default": true,
      "values": { "model": "gpt-5.6-luna", "reasoning_effort": "max" }
    },
    {
      "id": "sol-medium",
      "name": "Sol · Medium",
      "detail": "GPT-5.6-Sol · Medium reasoning",
      "is_default": false,
      "values": { "model": "gpt-5.6-sol", "reasoning_effort": "medium" }
    },
    {
      "id": "sol-max",
      "name": "Sol · Max",
      "detail": "GPT-5.6-Sol · Max reasoning",
      "is_default": false,
      "values": { "model": "gpt-5.6-sol", "reasoning_effort": "max" }
    }
  ],
  "host": {
    "schema_version": 2,
    "conversation_compaction": {
      "aliases": ["compact", "summarise", "summarize"],
      "fallback_command": "compact"
    },
    "account_usage": { "provider": "openai" },
    "transcript": {
      "schema_version": 1,
      "thought": {
        "variant": "workcell",
        "density": "comfortable",
        "active_label": "Thinking",
        "current_surface": "soft"
      }
    },
    "features": []
  },
  "runtime": {
    "driver_schema": 1,
    "protocol": "agent-client-protocol-1.3",
    "entrypoint": "codex-acp",
    "behavior": {
      "schema_version": 1,
      "permission": "acp_config_full_access_v1",
      "session": "portable_v1",
      "turn_end": "portable_v1",
      "configuration": "acp_config_options_v1",
      "default_preferences": {
        "model": "gpt-5.6-luna",
        "reasoning_effort": "max"
      },
      "error_rules": []
    },
    "arguments": [
      "-c",
      "approval_policy=never",
      "-c",
      "sandbox_mode=danger-full-access",
      "-c",
      "model_auto_compact_token_limit_scope=\"body_after_prefix\""
    ],
    "environment": {
      "CODEX_PATH": {
        "source": "component_command",
        "component": {
          "kind": "provider_cli",
          "slot": "codex"
        }
      }
    },
    "remove_environment": [],
    "remove_environment_prefixes": ["CHATGPT_", "CODEX_", "OPENAI_"],
    "dependencies": [
      {
        "id": "codex-acp",
        "version": "1.1.7",
        "source": "https://registry.npmjs.org/@agentclientprotocol/codex-acp/-/codex-acp-1.1.7.tgz",
        "integrity": "sha512-bhFLbGtOMEw6+PAp33vNERb6dXlULOfV3mWbRdps4v7sY7PHha/C2T1dnlG0yVcvBu9W+NYPzL0CAupnVoFTiQ==",
        "private": true
      },
      {
        "id": "openai-codex",
        "version": "0.147.0",
        "source": "https://registry.npmjs.org/@openai/codex/-/codex-0.147.0.tgz",
        "integrity": "sha512-EQLEXecAG2ptxI7UpBMo2TR/ga5596/c/OsYF/0LoUDh5JANZ7IoGqlzBEWbuEVQ76JePIbtTW/ihCkp1a7Z3w==",
        "private": true
      }
    ],
    "platforms": [
      {
        "os": "linux",
        "architecture": "x86_64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          }
        ]
      },
      {
        "os": "macos",
        "architecture": "aarch64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          }
        ]
      }
    ],
    "required_capabilities": ["provider.runtime.v1"]
  },
  "authentication": {
    "schema_version": 1,
    "required": true,
    "portable_schema": "codex-auth-v1",
    "projection_schema": "codex-home-v1",
    "refresh": "compare_and_swap",
    "methods": [
      {
        "id": "chatgpt",
        "label": "ChatGPT",
        "flow": "device_code",
        "executor": {
          "kind": "command_v1",
          "component": { "kind": "provider_cli", "slot": "codex" },
          "arguments": ["login", "--device-auth"],
          "terminal": "pipes",
          "challenge": "device_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": ["auth_json"]
      },
      {
        "id": "api-key",
        "label": "OpenAI API key",
        "flow": "secret_input",
        "executor": {
          "kind": "secret_input_v1",
          "bundle_key": "api_key",
          "verification_url": "https://platform.openai.com/api-keys"
        },
        "required_bundle_keys": ["api_key"]
      }
    ],
    "credential_files": [
      {
        "bundle_key": "auth_json",
        "relative_path": ".codex/auth.json",
        "required": false
      }
    ],
    "environment_projection": { "OPENAI_API_KEY": "api_key" }
  },
  "compatibility": {
    "min_controller_contract": 2,
    "max_controller_contract": 2,
    "min_machine_contract": 4,
    "max_machine_contract": 4,
    "ui_component_fingerprint": "",
    "auth_contract_fingerprint": ""
  }
}
