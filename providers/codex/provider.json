{
  "authoring_schema": 2,
  "id": "codex",
  "version": "1.0.0",
  "publisher": "cowboy-first-party",
  "sdk_version": "2.1.0",
  "display": {
    "name": "Codex",
    "vendor": "OpenAI",
    "summary": "Codex with its standard OpenAI account and configuration",
    "accent": "#4F6BED",
    "secondary_accent": "#168B78",
    "mark_view_box": "0 0 24 24",
    "mark_path": "M12 2.25a4.2 4.2 0 0 1 4.05 3.1 4.2 4.2 0 0 1 2.7 6.65 4.2 4.2 0 0 1-2.7 6.65 4.2 4.2 0 0 1-8.1 0A4.2 4.2 0 0 1 5.25 12a4.2 4.2 0 0 1 2.7-6.65A4.2 4.2 0 0 1 12 2.25Zm0 4.15-4.85 2.8v5.6L12 17.6l4.85-2.8V9.2L12 6.4Z"
  },
  "card_layout": "mark_leading",
  "configuration_presets": [
    {
      "id": "luna-max",
      "name": "Luna · Max",
      "detail": "GPT-5.6-Luna · Max reasoning",
      "is_default": true,
      "values": { "model": "gpt-5.6-luna", "reasoning_effort": "max" }
    },
    {
      "id": "sol-medium",
      "name": "Sol · Medium",
      "detail": "GPT-5.6-Sol · Medium reasoning",
      "is_default": false,
      "values": { "model": "gpt-5.6-sol", "reasoning_effort": "medium" }
    },
    {
      "id": "sol-max",
      "name": "Sol · Max",
      "detail": "GPT-5.6-Sol · Max reasoning",
      "is_default": false,
      "values": { "model": "gpt-5.6-sol", "reasoning_effort": "max" }
    }
  ],
  "host": {
    "schema_version": 1,
    "conversation_compaction": {
      "aliases": ["compact", "summarise", "summarize"],
      "fallback_command": "compact"
    },
    "account_usage": { "provider": "openai" },
    "features": []
  },
  "runtime": {
    "driver_schema": 1,
    "protocol": "agent-client-protocol-1.3",
    "entrypoint": "codex-acp",
    "behavior": {
      "schema_version": 1,
      "permission": "acp_config_full_access_v1",
      "session": "portable_v1",
      "turn_end": "portable_v1",
      "configuration": "acp_config_options_v1",
      "default_preferences": {
        "model": "gpt-5.6-luna",
        "reasoning_effort": "max"
      },
      "error_rules": []
    },
    "arguments": [
      "-c",
      "approval_policy=never",
      "-c",
      "sandbox_mode=danger-full-access",
      "-c",
      "model_auto_compact_token_limit_scope=\"body_after_prefix\""
    ],
    "environment": {},
    "remove_environment": [],
    "remove_environment_prefixes": ["CHATGPT_", "CODEX_", "OPENAI_"],
    "dependencies": [
      {
        "id": "codex-acp",
        "version": "1.1.7",
        "source": "https://registry.npmjs.org/@agentclientprotocol/codex-acp/-/codex-acp-1.1.7.tgz",
        "integrity": "sha512-bhFLbGtOMEw6+PAp33vNERb6dXlULOfV3mWbRdps4v7sY7PHha/C2T1dnlG0yVcvBu9W+NYPzL0CAupnVoFTiQ==",
        "private": true
      },
      {
        "id": "openai-codex",
        "version": "0.147.0",
        "source": "https://registry.npmjs.org/@openai/codex/-/codex-0.147.0.tgz",
        "integrity": "sha512-EQLEXecAG2ptxI7UpBMo2TR/ga5596/c/OsYF/0LoUDh5JANZ7IoGqlzBEWbuEVQ76JePIbtTW/ihCkp1a7Z3w==",
        "private": true
      }
    ],
    "platforms": [
      {
        "os": "linux",
        "architecture": "x86_64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          }
        ]
      },
      {
        "os": "linux",
        "architecture": "aarch64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          }
        ]
      },
      {
        "os": "macos",
        "architecture": "aarch64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          }
        ]
      }
    ],
    "required_capabilities": ["provider.runtime.v1"]
  },
  "authentication": {
    "schema_version": 1,
    "required": true,
    "portable_schema": "codex-auth-v1",
    "projection_schema": "codex-home-v1",
    "refresh": "compare_and_swap",
    "methods": [
      {
        "id": "chatgpt",
        "label": "ChatGPT",
        "flow": "device_code",
        "executor": {
          "kind": "command_v1",
          "component": { "kind": "provider_cli", "slot": "codex" },
          "arguments": ["login", "--device-auth"],
          "terminal": "pipes",
          "challenge": "device_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": ["auth_json"]
      },
      {
        "id": "api-key",
        "label": "OpenAI API key",
        "flow": "secret_input",
        "executor": {
          "kind": "secret_input_v1",
          "bundle_key": "api_key",
          "verification_url": "https://platform.openai.com/api-keys"
        },
        "required_bundle_keys": ["api_key"]
      }
    ],
    "credential_files": [
      {
        "bundle_key": "auth_json",
        "relative_path": ".codex/auth.json",
        "required": false
      }
    ],
    "environment_projection": { "OPENAI_API_KEY": "api_key" }
  },
  "compatibility": {
    "min_controller_contract": 2,
    "max_controller_contract": 2,
    "min_machine_contract": 4,
    "max_machine_contract": 4,
    "ui_component_fingerprint": "",
    "auth_contract_fingerprint": ""
  }
}
