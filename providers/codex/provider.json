{
  "authoring_schema": 2,
  "id": "codex",
  "version": "1.1.3",
  "publisher": "cowboy-first-party",
  "sdk_version": "2.4.0",
  "display": {
    "name": "Codex",
    "vendor": "OpenAI",
    "summary": "Codex with its standard OpenAI account and configuration",
    "accent": "#4F6BED",
    "secondary_accent": "#168B78",
    "mark_view_box": "0 0 24 24",
    "mark_path": "M8.086.457a6.105 6.105 0 013.046-.415c1.333.153 2.521.72 3.564 1.7a.117.117 0 00.107.029c1.408-.346 2.762-.224 4.061.366l.063.03.154.076c1.357.703 2.33 1.77 2.918 3.198.278.679.418 1.388.421 2.126a5.655 5.655 0 01-.18 1.631.167.167 0 00.04.155 5.982 5.982 0 011.578 2.891c.385 1.901-.01 3.615-1.183 5.14l-.182.22a6.063 6.063 0 01-2.934 1.851.162.162 0 00-.108.102c-.255.736-.511 1.364-.987 1.992-1.199 1.582-2.962 2.462-4.948 2.451-1.583-.008-2.986-.587-4.21-1.736a.145.145 0 00-.14-.032c-.518.167-1.04.191-1.604.185a5.924 5.924 0 01-2.595-.622 6.058 6.058 0 01-2.146-1.781c-.203-.269-.404-.522-.551-.821a7.74 7.74 0 01-.495-1.283 6.11 6.11 0 01-.017-3.064.166.166 0 00.008-.074.115.115 0 00-.037-.064 5.958 5.958 0 01-1.38-2.202 5.196 5.196 0 01-.333-1.589 6.915 6.915 0 01.188-2.132c.45-1.484 1.309-2.648 2.577-3.493.282-.188.55-.334.802-.438.286-.12.573-.22.861-.304a.129.129 0 00.087-.087A6.016 6.016 0 015.635 2.31C6.315 1.464 7.132.846 8.086.457zm-.804 7.85a.848.848 0 00-1.473.842l1.694 2.965-1.688 2.848a.849.849 0 001.46.864l1.94-3.272a.849.849 0 00.007-.854l-1.94-3.393zm5.446 6.24a.849.849 0 000 1.695h4.848a.849.849 0 000-1.696h-4.848z"
  },
  "card_layout": "mark_leading",
  "activity": {
    "indicator": { "kind": "terminal_prompt", "interval_ms": 4200 },
    "label": {
      "kind": "phrase_cycle",
      "phrases": [
        "Inspecting",
        "Searching",
        "Reasoning",
        "Editing",
        "Testing",
        "Reviewing",
        "Refining",
        "Verifying",
        "Working"
      ],
      "interval_ms": 4200,
      "suffix": "…",
      "effect": "shimmer"
    },
    "accessible_label": "Codex is working"
  },
  "configuration_presets": [
    {
      "id": "luna-max",
      "name": "Luna · Max",
      "detail": "GPT-5.6-Luna · Max reasoning",
      "is_default": true,
      "values": { "model": "gpt-5.6-luna", "reasoning_effort": "max" }
    },
    {
      "id": "sol-medium",
      "name": "Sol · Medium",
      "detail": "GPT-5.6-Sol · Medium reasoning",
      "is_default": false,
      "values": { "model": "gpt-5.6-sol", "reasoning_effort": "medium" }
    },
    {
      "id": "sol-max",
      "name": "Sol · Max",
      "detail": "GPT-5.6-Sol · Max reasoning",
      "is_default": false,
      "values": { "model": "gpt-5.6-sol", "reasoning_effort": "max" }
    }
  ],
  "host": {
    "schema_version": 2,
    "conversation_compaction": {
      "aliases": ["compact", "summarise", "summarize"],
      "fallback_command": "compact"
    },
    "account_usage": { "provider": "openai" },
    "transcript": {
      "schema_version": 1,
      "thought": {
        "variant": "workcell",
        "density": "comfortable",
        "active_label": "Thinking",
        "current_surface": "soft"
      }
    },
    "features": []
  },
  "runtime": {
    "driver_schema": 1,
    "protocol": "agent-client-protocol-1.3",
    "entrypoint": "codex-acp",
    "behavior": {
      "schema_version": 1,
      "permission": "acp_config_full_access_v1",
      "session": "portable_v1",
      "turn_end": "portable_v1",
      "configuration": "acp_config_options_v1",
      "default_preferences": {
        "model": "gpt-5.6-luna",
        "reasoning_effort": "max"
      },
      "error_rules": []
    },
    "arguments": [
      "-c",
      "approval_policy=never",
      "-c",
      "sandbox_mode=danger-full-access",
      "-c",
      "model_auto_compact_token_limit_scope=\"body_after_prefix\""
    ],
    "environment": {
      "CODEX_PATH": {
        "source": "component_command",
        "component": {
          "kind": "provider_cli",
          "slot": "codex"
        }
      }
    },
    "remove_environment": [],
    "remove_environment_prefixes": ["CHATGPT_", "CODEX_", "OPENAI_"],
    "dependencies": [
      {
        "id": "codex-acp",
        "version": "1.1.7",
        "source": "https://registry.npmjs.org/@agentclientprotocol/codex-acp/-/codex-acp-1.1.7.tgz",
        "integrity": "sha512-bhFLbGtOMEw6+PAp33vNERb6dXlULOfV3mWbRdps4v7sY7PHha/C2T1dnlG0yVcvBu9W+NYPzL0CAupnVoFTiQ==",
        "private": true
      },
      {
        "id": "openai-codex",
        "version": "0.147.0",
        "source": "https://registry.npmjs.org/@openai/codex/-/codex-0.147.0.tgz",
        "integrity": "sha512-EQLEXecAG2ptxI7UpBMo2TR/ga5596/c/OsYF/0LoUDh5JANZ7IoGqlzBEWbuEVQ76JePIbtTW/ihCkp1a7Z3w==",
        "private": true
      }
    ],
    "platforms": [
      {
        "os": "linux",
        "architecture": "x86_64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          }
        ]
      },
      {
        "os": "macos",
        "architecture": "aarch64",
        "payload_digest": "",
        "launch_command": "codex-acp",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "codex",
            "dependency": "openai-codex",
            "command": "codex"
          },
          {
            "kind": "provider_adapter",
            "slot": "codex",
            "dependency": "codex-acp",
            "command": "codex-acp"
          }
        ]
      }
    ],
    "required_capabilities": ["provider.runtime.v1"]
  },
  "authentication": {
    "schema_version": 1,
    "required": true,
    "portable_schema": "codex-auth-v1",
    "projection_schema": "codex-home-v1",
    "refresh": "compare_and_swap",
    "methods": [
      {
        "id": "chatgpt",
        "label": "ChatGPT subscription",
        "flow": "device_code",
        "executor": {
          "kind": "command_v1",
          "component": { "kind": "provider_cli", "slot": "codex" },
          "arguments": ["login", "--device-auth"],
          "terminal": "pipes",
          "challenge": "device_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": ["auth_json"]
      },
      {
        "id": "api-key",
        "label": "OpenAI API key",
        "flow": "secret_input",
        "executor": {
          "kind": "secret_input_v1",
          "bundle_key": "api_key",
          "verification_url": "https://platform.openai.com/api-keys"
        },
        "required_bundle_keys": ["api_key"]
      }
    ],
    "credential_files": [
      {
        "bundle_key": "auth_json",
        "relative_path": ".codex/auth.json",
        "required": false
      }
    ],
    "environment_projection": { "OPENAI_API_KEY": "api_key" }
  },
  "compatibility": {
    "min_controller_contract": 2,
    "max_controller_contract": 2,
    "min_machine_contract": 4,
    "max_machine_contract": 4,
    "ui_component_fingerprint": "",
    "auth_contract_fingerprint": ""
  }
}
