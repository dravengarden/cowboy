--- /dev/null
+++ b/test_regression.py
@@ -0,0 +1,26 @@
+import unittest
+from server import respond
+
+INVALID = {"error": "invalid integer"}
+
+
+class SumRegression(unittest.TestCase):
+    def test_single_and_zero(self):
+        self.assertEqual(respond("/sum?a=0"), (200, {"sum": 0}))
+        self.assertEqual(respond("/sum?a=42"), (200, {"sum": 42}))
+
+    def test_signed_and_multi_digit(self):
+        self.assertEqual(respond("/sum?a=%2B10&a=-3&a=15"), (200, {"sum": 22}))
+
+    def test_sum_is_numeric_not_concatenated(self):
+        self.assertEqual(respond("/sum?a=10&a=20"), (200, {"sum": 30}))
+
+    def test_invalid_values(self):
+        for path in ["/sum?a=1.5", "/sum?a=1_0", "/sum?a=%201", "/sum?a=-", "/sum?b=3", "/sum?a=1&a=x"]:
+            with self.subTest(path=path):
+                self.assertEqual(respond(path), (400, INVALID))
+
+    def test_unknown_paths(self):
+        for path in ["/", "/health", "/sum/", "/sums?a=1"]:
+            with self.subTest(path=path):
+                self.assertEqual(respond(path), (404, {"error": "not found"}))
