@@ -0,0 +1,18 @@
+import unittest
+from server import respond
+
+
+class Contract(unittest.TestCase):
+    def test_sum(self):
+        self.assertEqual(respond('/sum?a=2&a=3'), (200, {'sum': 5}))
+
+    def test_negative(self):
+        self.assertEqual(respond('/sum?a=-7&a=2&a=0'), (200, {'sum': -5}))
+
+    def test_invalid(self):
+        for path in ['/sum', '/sum?a=', '/sum?a=2&a=', '/sum?a=abc']:
+            with self.subTest(path=path):
+                self.assertEqual(respond(path), (400, {'error': 'invalid integer'}))
+
+    def test_unknown(self):
+        self.assertEqual(respond('/other?a=2'), (404, {'error': 'not found'}))
