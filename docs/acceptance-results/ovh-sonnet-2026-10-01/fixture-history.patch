diff --git a/server.py b/server.py
index 8ec0a5f..70a5df4 100644
--- a/server.py
+++ b/server.py
@@ -1,12 +1,19 @@
 import json
+import re
 from http.server import BaseHTTPRequestHandler, HTTPServer
 from urllib.parse import parse_qs, urlsplit
 
+INTEGER = re.compile(r"[+-]?[0-9]+")
+
 
 def respond(target):
-    query = parse_qs(urlsplit(target).query)
-    values = query.get("a", ["0"])
-    return 200, {"sum": "".join(values)}
+    parts = urlsplit(target)
+    if parts.path != "/sum":
+        return 404, {"error": "not found"}
+    values = parse_qs(parts.query, keep_blank_values=True).get("a", [])
+    if not values or not all(INTEGER.fullmatch(v) for v in values):
+        return 400, {"error": "invalid integer"}
+    return 200, {"sum": sum(int(v) for v in values)}
 
 
 class Handler(BaseHTTPRequestHandler):
