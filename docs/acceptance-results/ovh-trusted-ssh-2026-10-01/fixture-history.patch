@@ -0,0 +1,61 @@
+"""Frozen regression for process concurrency and durable JSON writes."""
+from concurrent.futures import ThreadPoolExecutor
+import json
+from pathlib import Path
+import resource
+import subprocess
+import sys
+import tempfile
+import unittest
+
+CLI = Path(__file__).with_name('taskboard.py')
+
+
+class StorageTests(unittest.TestCase):
+    def test_concurrent_adds_preserve_all_successful_mutations(self):
+        with tempfile.TemporaryDirectory() as directory:
+            db = Path(directory) / 'tasks.json'
+            existing = [dict(id=i, title='seed-' + str(i) + 'x' * 300, tags=[], done=False)
+                        for i in range(1, 301)]
+            db.write_text(json.dumps(dict(next_id=301, tasks=existing)))
+            db.chmod(0o600)
+
+            def add(i):
+                return subprocess.run([sys.executable, str(CLI), '--db', str(db), 'add', 'new-' + str(i)],
+                                      capture_output=True, text=True, timeout=30)
+
+            with ThreadPoolExecutor(max_workers=8) as pool:
+                results = list(pool.map(add, range(80)))
+            self.assertTrue(all(result.returncode == 0 for result in results), 'a concurrent CLI call failed')
+            state = json.loads(db.read_text())
+            self.assertEqual(len(state['tasks']), 380)
+            self.assertEqual(sorted(task['id'] for task in state['tasks']), list(range(1, 381)))
+            self.assertEqual(state['next_id'], 381)
+            self.assertEqual(state['tasks'][:300], existing)
+            self.assertEqual(db.stat().st_mode & 0o777, 0o600)
+
+    def test_failed_write_preserves_previous_database(self):
+        with tempfile.TemporaryDirectory() as directory:
+            db = Path(directory) / 'tasks.json'
+            original = b'{"next_id":1,"tasks":[]}\n'
+            db.write_bytes(original)
+            db.chmod(0o600)
+
+            def limit():
+                resource.setrlimit(resource.RLIMIT_FSIZE, (512, 512))
+
+            result = subprocess.run([sys.executable, str(CLI), '--db', str(db), 'add', 'x' * 5000],
+                                    capture_output=True, timeout=30, preexec_fn=limit)
+            self.assertNotEqual(result.returncode, 0)
+            self.assertEqual(db.read_bytes(), original)
+
+    def test_new_database_is_private(self):
+        with tempfile.TemporaryDirectory() as directory:
+            db = Path(directory) / 'tasks.json'
+            subprocess.run([sys.executable, str(CLI), '--db', str(db), 'add', 'first'],
+                           check=True, capture_output=True)
+            self.assertEqual(db.stat().st_mode & 0o777, 0o600)
+
+
+if __name__ == '__main__':
+    unittest.main()
-- 
