+import csv
+import io
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+
+class Export(unittest.TestCase):
+    def test_csv_escaping_filter_order_and_read_only(self):
+        rows = [dict(id=3, title='skip', tags=['other'], done=False),
+                dict(id=2, title='quote " and, comma\n新行', tags=['work', 'a'], done=True),
+                dict(id=1, title='first', tags=['work'], done=False)]
+        with tempfile.TemporaryDirectory() as directory:
+            db = Path(directory) / '任务 board.json'
+            db.write_text(json.dumps(dict(next_id=4, tasks=rows), ensure_ascii=False))
+            before = db.read_bytes()
+            result = subprocess.run([sys.executable, 'taskboard.py', '--db', str(db),
+                                     'export', '--format', 'csv', '--tag', 'work'],
+                                    capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            parsed = list(csv.DictReader(io.StringIO(result.stdout)))
+            self.assertEqual(parsed, [dict(id='1', title='first', done='false', tags='work'),
+                                     dict(id='2', title='quote " and, comma\n新行', done='true', tags='a;work')])
+            self.assertTrue(result.stdout.startswith('id,title,done,tags\n'))
+            self.assertEqual(db.read_bytes(), before)
+
+    def test_empty_export_header_without_creating_database(self):
+        with tempfile.TemporaryDirectory() as directory:
+            db = Path(directory) / 'absent.json'
+            result = subprocess.run([sys.executable, 'taskboard.py', '--db', str(db), 'export', '--format', 'csv'],
+                                    capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(result.stdout, 'id,title,done,tags\n')
+            self.assertFalse(db.exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
