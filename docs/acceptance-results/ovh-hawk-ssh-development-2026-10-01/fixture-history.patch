+++ b/test_storage_regressions.py
@@ -0,0 +1,92 @@
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import sys
+import tempfile
+from threading import Event, Thread
+import unittest
+from unittest.mock import patch
+
+import taskboard
+
+
+class StorageRegressions(unittest.TestCase):
+    def test_existing_database_permissions_are_preserved(self):
+        with tempfile.TemporaryDirectory() as directory:
+            db = Path(directory) / 'tasks.json'
+            db.write_text(json.dumps(dict(next_id=1, tasks=[])))
+            db.chmod(0o640)
+
+            result = subprocess.run(
+                [sys.executable, 'taskboard.py', '--db', str(db), 'add', 'kept mode'],
+                capture_output=True,
+                text=True,
+            )
+
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(stat.S_IMODE(db.stat().st_mode), 0o640)
+            self.assertEqual(json.loads(db.read_text())['tasks'][0]['title'], 'kept mode')
+
+    def test_corrupt_database_is_rejected_without_reset(self):
+        with tempfile.TemporaryDirectory() as directory:
+            db = Path(directory) / 'tasks.json'
+            original = b'{"next_id":1,"tasks":[not valid JSON]}\n'
+            db.write_bytes(original)
+            db.chmod(0o600)
+
+            result = subprocess.run(
+                [sys.executable, 'taskboard.py', '--db', str(db), 'add', 'must not replace data'],
+                capture_output=True,
+            )
+
+            self.assertNotEqual(result.returncode, 0)
+            self.assertEqual(db.read_bytes(), original)
+
+    def test_readers_see_complete_old_state_until_atomic_commit(self):
+        with tempfile.TemporaryDirectory() as directory:
+            db = Path(directory) / 'tasks.json'
+            old_state = dict(next_id=2, tasks=[
+                dict(id=1, title='old', tags=[], done=False),
+            ])
+            new_state = dict(next_id=3, tasks=[
+                dict(id=1, title='old', tags=[], done=False),
+                dict(id=2, title='new', tags=[], done=False),
+            ])
+            db.write_text(json.dumps(old_state) + '\n')
+
+            at_commit = Event()
+            allow_commit = Event()
+            failures = []
+            actual_replace = os.replace
+
+            def pause_at_commit(source, destination):
+                at_commit.set()
+                if not allow_commit.wait(timeout=10):
+                    raise TimeoutError('test did not release the commit')
+                actual_replace(source, destination)
+
+            def write_state():
+                try:
+                    taskboard.save(db, new_state)
+                except BaseException as error:
+                    failures.append(error)
+
+            with patch.object(taskboard.os, 'replace', side_effect=pause_at_commit):
+                writer = Thread(target=write_state)
+                writer.start()
+                try:
+                    self.assertTrue(at_commit.wait(timeout=10))
+                    self.assertEqual(json.loads(db.read_text()), old_state)
+                finally:
+                    allow_commit.set()
+                    writer.join(timeout=10)
+
+            self.assertFalse(writer.is_alive())
+            self.assertEqual(failures, [])
+            self.assertEqual(json.loads(db.read_text()), new_state)
+
+
+if __name__ == '__main__':
+    unittest.main()
