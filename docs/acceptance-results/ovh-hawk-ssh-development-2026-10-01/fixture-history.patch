+import unittest
+
+
+class ExportRegressions(unittest.TestCase):
+    def test_numeric_order_unique_tags_and_lf_output(self):
+        rows = [
+            dict(id=10, title='ten', done=False, tags=['work', 'z', 'work']),
+            dict(id=2, title='two', done=True, tags=['work', 'a', 'work']),
