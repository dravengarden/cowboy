  "changes": [
    "Read of a .pdf: pdfinfo on the target counts pages (more than 10 refused); a whole PDF returns native's document result; pages renders JPEG images with pdftoppm -jpeg -r 100 on the target as native's page images; native messages for empty, oversized, corrupt, protected and out-of-range files and for a missing pdftoppm",
    "the rendering belongs to the tool call and is cancelled with it; rendered pages are read from a private target directory that is removed",
    "pages is ignored for files not named .pdf; PDF bytes under another name read as text",
    "native's binary-extension list is refused by name; a missing file reads 'File does not exist. Note: your current working directory is <cwd>.'",
    "whole PDFs above 10 MB and page images above 10 MB in all are refused (one execution/bridge message)"
  ],
  "gates": {
    "source_tests": 205,
    "check_compact": "passed on release commit 3d73db7f (origin/main had no new commits)",
    "native_review": "3 read-only Codex review rounds; fixed: rendering not cancelled with its call, whole PDFs and page images exceeding one execution or bridge message, missing-file message skipped behind the range helper's metadata call; declined: recording read state for PDFs (native's PDF branch records none)",
    "candidate_acceptance": "first candidate failed an existing check that read a .bin file as lossy text (natively refused by name; the fixture now uses an unlisted extension) and the missing-file cases"
  },
