  "changes": [
    "image Reads (.png .jpg .jpeg .gif .webp, or extensionless image bytes) go through native's own Read of a private runtime copy (0600 in a 0700 directory beside the plugin state), so native's checks, resizing, recompression and size note apply; refusals name the target file; the copy is removed afterwards and leftovers at launcher start",
    "target bytes above the execution message limit are read in 4 MB parts (split on the target), up to 64 MB",
    "image bytes under a non-image name read as text, as natively"
  ],
  "gates": {
    "source_tests": 206,
    "check_compact": "passed on commit 1a3bae91 (origin/main had no new commits)",
    "native_review": "2 read-only Codex review rounds; fixed: $ replacement patterns in a target path; the second reported none",
    "candidate_acceptance": "first candidate dropped native's size note and returned refusals in an error form; both fixed"
  },
