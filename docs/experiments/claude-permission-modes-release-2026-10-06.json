        "log_sha256": "sha256:3d3e191c1a3dcd0bc3f911a830994af352ccdb9c0c142a99b527a419a82ad98a"
      }
    ],
    "docs_index": "no Markdown pages added"
  },
  "native_baselines": {
    "method": "offline native-local tools with an observer Mod calling $.tool.check",
    "findings": [
      "check agrees with native prompts in default and acceptEdits",
      "dontAsk: check reports ask while native denies silently",
      "cd to an outside directory itself requires approval, so a cd-prefixed probe cannot classify commands",
      "native resolves symlinks for Bash, Edit and Read paths; Write onto a symlink is denied in every mode"
    ],
    "scratch_root": "/home/draven/worktrees/cowboy/remote-native-parity-evidence-20261005/scratch-permissions",
