  "changes": [
    "remove the forced bypassPermissions launch flag; Cowboy still selects bypass at session start",
    "gate every target tool with native $.tool.check before any target effect",
    "raise asks to the SDK host as native can_use_tool from the launcher; honor updatedInput, setMode and interrupt; withdraw with control_cancel_request",
    "dontAsk denies asks without a request",
    "judge paths as target paths; outside paths under a sentinel root; original-argument rules still match",
    "refuse Write onto a symlink in every mode as natively; re-check workspace-scoped allowances against the target real path"
  ],
  "gates": {
    "source_tests": 122,
    "check_compact": "passed on the release commit and again after integrating origin/main",
    "native_review": "four read-only Codex review rounds; three found P1/P2 path, rule and mode-blind command defects, each fixed with regressions; the fourth found none",
    "negative_controls": [
      {
        "result": "a candidate without the gate fails: default mode did not ask the host",
