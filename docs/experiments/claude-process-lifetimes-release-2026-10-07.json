  "changes": [
    "a Bash command ends when its shell exits, not when its output pipe closes: a child holding the output no longer makes the call wait for its timeout (or kills a command starting with sleep); exit, exec and traps report their status",
    "the shell runs under a minimal parent that writes a per-command end line with the status to both streams and exits with that status; its own notices are discarded",
    "background completion notifications follow the shell's exit",
    "stopping a command (TaskStop, timeout, interrupt) kills its whole process tree: native's snapshot leaves job control on, so & jobs had their own groups and survived the executor's group kill",
    "TaskStop answers in native's shape with the command; a finished command reads as 'No task found with ID: <id>'; task commands are kept only while running, bounded"
  ],
  "gates": {
    "source_tests": 199,
    "check_compact": "passed on merge 3a808a13 (brought Rust changes from origin/main)",
    "native_review": "5 read-only Codex review rounds; fixed: the parent shell's success status reported for a large background output whose end line was on a later page, a tree kill cached before the process existed, unbounded persisted task commands, stdout's end line taken as stderr's; the fifth reported none",
    "candidate_acceptance": "found two defects before review: output past one read lost when the executor reported closed before the end line, and job-control groups surviving stops"
  },
  "native_baselines": {
    "baseline": "tools/claude_lifecycle_native_baseline.json (tools/claude_lifecycle_native_probe.py, cases tools/claude_lifecycle_cases.py)",
