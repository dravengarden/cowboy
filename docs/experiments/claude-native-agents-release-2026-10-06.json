  "changes": [
    "admit native background Agent; child calls carry agentId to the target route",
    "project exact registered agent output locators to cowboy-agent:// in launch results, idle/queued notifications and client frames",
    "durable session-scoped agent outcomes; handle Read returns the recorded final answer or status",
    "SendMessage/TaskStop native only for registered agents; isolation, foreground, custom and nested agents refused",
    "per-call and per-agent cancellation, including queued mutations and discarded background starts",
    "interrupt forwarded to native before target cancellation",
    "bridge idle hold 20 s -> 1 s because a pending Mods fetch blocks other native work",
    "resume readiness tolerates only a zero-turn zero-API task-notification result"
  ],
  "gates": {
    "source_tests": 99,
    "source_gate": "passed",
    "check_compact": "passed on the committed tree",
    "native_review": "five read-only Codex review rounds; rounds 1-4 found P2 continuation, expiry, cancellation-window and state-budget defects, each fixed with a regression; round 5 found no defect",
    "negative_controls": [
      "restoring only the 20 s bridge hold in a disposable copy of the candidate fails parent_turns_and_taskstop_progress_during_child_command",
      "earlier candidates observed the uncancelled child after TaskStop, the post-interrupt child model request and the unprojected queued notification before their fixes"
    ],
    "docs_index": "no Markdown pages added; changed pages already indexed"
  },
