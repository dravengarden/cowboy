{
  "schema_version": 1,
  "id": "cloudflare-email",
  "version": "1.0.0",
  "display_name": "Email",
  "button_label": "Continue with email",
  "protocol": {
    "kind": "open_id_connect",
    "configuration": {
      "issuer": "https://email-login.example.com",
      "authorization_endpoint": "https://email-login.example.com/oauth2/authorize",
      "token_endpoint": "https://email-login.example.com/oauth2/token",
      "jwks_uri": "https://email-login.example.com/oauth2/jwks",
      "scopes": ["openid", "email"],
      "client_authentication_methods": ["client_secret_post"],
      "id_token_signing_algorithms": ["RS256"],
      "authorization_parameters": {}
    }
  }
}
