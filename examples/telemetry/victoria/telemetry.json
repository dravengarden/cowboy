{
  "schema_version": 2,
  "id": "victoria",
  "version": "1.1.0",
  "display_name": "VictoriaLogs + VictoriaMetrics + VictoriaTraces",
  "supported_platforms": [{ "os": "linux", "architecture": "x86_64" }],
  "logs": {
    "encoding": "otlp_http_protobuf",
    "path": "/insert/opentelemetry/v1/logs",
    "query": {}
  },
  "metrics": {
    "encoding": "otlp_http_protobuf",
    "path": "/opentelemetry/v1/metrics",
    "query": {}
  },
  "traces": {
    "encoding": "otlp_http_protobuf",
    "path": "/insert/opentelemetry/v1/traces",
    "query": {}
  }
}
