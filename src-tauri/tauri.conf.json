{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cowboy",
  "version": "0.1.0",
  "identifier": "top.thundersparrow.cowboy",
  "build": {
    "devUrl": "https://cowboy.hawk.thundersparrow.top",
    "frontendDist": "https://cowboy.hawk.thundersparrow.top"
  },
  "app": {
    "windows": [
      {
        "title": "Cowboy",
        "width": 1100,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
