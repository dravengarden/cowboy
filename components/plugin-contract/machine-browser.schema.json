{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowboy.stormbird.xyz/schemas/machine-browser-v1.json",
  "title": "Cowboy Machine browser",
  "description": "Signed browser runtime for owner-operated account sign-in on a Linux Machine. The contract names artifact-relative executables, the browser policy binding and host requirements; admission, isolation, streaming and the viewer stay core. It never names URLs, credentials or executables outside the signed artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "display_name",
    "description",
    "supported_platforms",
    "host_requirements",
    "runtime",
    "launch"
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\x00\\\\]+(?<!/)$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1024,
      "pattern": "^/(?!.*(^|/)\\.\\.?(/|$))[^\\x00\\\\]+(?<!/)$"
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]*\\S[^\\x00-\\x1f\\x7f]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\x00-\\x1f\\x7f]*\\S[^\\x00-\\x1f\\x7f]*$"
    },
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "architecture"
        ],
        "properties": {
          "os": {
            "const": "linux"
          },
          "architecture": {
            "const": "x86_64"
          }
        }
      }
    },
    "host_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernel_min",
        "merged_usr",
        "mount_points",
        "apparmor_features",
        "built_from"
      ],
      "properties": {
        "kernel_min": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "merged_usr": {
          "const": true
        },
        "mount_points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        },
        "apparmor_features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
          }
        },
        "built_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            },
            "version_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9.]{1,32}$"
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "launcher",
        "browser",
        "browser_version",
        "display_server",
        "helpers",
        "policy"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "launcher": {
          "$ref": "#/$defs/relativePath"
        },
        "browser": {
          "$ref": "#/$defs/relativePath"
        },
        "browser_version": {
          "type": "string",
          "pattern": "^[0-9]{1,9}(\\.[0-9]{1,9}){1,3}$"
        },
        "display_server": {
          "$ref": "#/$defs/relativePath"
        },
        "helpers": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "directory"
          ],
          "properties": {
            "file": {
              "$ref": "#/$defs/relativePath"
            },
            "directory": {
              "type": "string",
              "pattern": "^/etc/(?!.*(^|/)\\.\\.?(/|$))[^\\x00\\\\]+(?<!/)$"
            }
          }
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "readiness_timeout_ms"
      ],
      "properties": {
        "protocol": {
          "const": "cowboy-browser-control-v1"
        },
        "readiness_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        }
      }
    }
  }
}
