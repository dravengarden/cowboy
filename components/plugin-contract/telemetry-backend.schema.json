{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowboy.stormbird.xyz/schemas/telemetry-backend-v1.json",
  "title": "Cowboy telemetry backend",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "display_name",
    "supported_platforms"
  ],
  "anyOf": [{ "required": ["logs"] }, { "required": ["metrics"] }],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]*\\S[^\\x00-\\x1f\\x7f]*$"
    },
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "architecture"],
        "properties": {
          "os": { "enum": ["linux", "macos"] },
          "architecture": { "enum": ["x86_64", "aarch64"] }
        }
      }
    },
    "logs": { "$ref": "#/$defs/logs" },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(/[A-Za-z0-9_-]+)+$"
    },
    "mapping": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_,]+$"
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "path"],
      "properties": {
        "encoding": { "const": "json_lines" },
        "path": { "$ref": "#/$defs/path" },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "_stream_fields": { "$ref": "#/$defs/mapping" },
            "_time_field": { "$ref": "#/$defs/mapping" },
            "_msg_field": { "$ref": "#/$defs/mapping" }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "path"],
      "properties": {
        "encoding": { "const": "prometheus_text" },
        "path": { "$ref": "#/$defs/path" },
        "query": { "type": "object", "additionalProperties": false }
      }
    }
  }
}
