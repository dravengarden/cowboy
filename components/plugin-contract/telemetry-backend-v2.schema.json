{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cowboy.stormbird.xyz/schemas/telemetry-backend-v2.json",
  "title": "Cowboy OTLP telemetry backend",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "display_name",
    "supported_platforms"
  ],
  "anyOf": [
    {
      "required": [
        "logs"
      ]
    },
    {
      "required": [
        "metrics"
      ]
    },
    {
      "required": [
        "traces"
      ]
    }
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f]*\\S[^\\x00-\\x1f\\x7f]*$"
    },
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "architecture"
        ],
        "properties": {
          "os": {
            "enum": [
              "linux",
              "macos"
            ]
          },
          "architecture": {
            "enum": [
              "x86_64",
              "aarch64"
            ]
          }
        }
      }
    },
    "logs": {
      "$ref": "#/$defs/route"
    },
    "metrics": {
      "$ref": "#/$defs/route"
    },
    "traces": {
      "$ref": "#/$defs/route"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(/[A-Za-z0-9_-]+)+$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "path"
      ],
      "properties": {
        "encoding": {
          "const": "otlp_http_protobuf"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "query": {
          "type": "object",
          "additionalProperties": false
        }
      }
    }
  }
}
