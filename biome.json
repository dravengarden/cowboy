{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!web/src/App.tsx",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/target"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none",
      "expand": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": false
  }
}
