{
  "authoring_schema": 2,
  "id": "antigravity",
  "version": "0.2.0",
  "publisher": "cowboy-first-party",
  "sdk_version": "3.6.0",
  "display": {
    "name": "Antigravity",
    "vendor": "Google",
    "summary": "Official Antigravity CLI with a personal Google account (not Google-supported in Cowboy)",
    "accent": "#8AB4F8",
    "secondary_accent": "#81C995",
    "mark_view_box": "0 0 24 24",
    "mark_path": "M12 2.5 22 21.5h-4.4L12 10.4 6.4 21.5H2zM12 15.2a2.1 2.1 0 1 1 0 4.2 2.1 2.1 0 0 1 0-4.2z"
  },
  "card_layout": "mark_leading",
  "activity": {
    "indicator": {
      "kind": "mark_pulse",
      "interval_ms": 1650
    },
    "label": {
      "kind": "text",
      "value": {
        "source": "literal",
        "value": "Working…"
      },
      "effect": "shimmer"
    },
    "accessible_label": "Antigravity is working"
  },
  "configuration_presets": [
    {
      "id": "gemini-flash-high",
      "name": "Gemini 3.8 Flash · High",
      "detail": "Gemini 3.8 Flash · High thinking",
      "is_default": true,
      "values": {
        "model": "gemini-3.8-flash",
        "thought_level": "high"
      }
    }
  ],
  "host": {
    "schema_version": 2,
    "conversation_compaction": {
      "aliases": [
        "compact",
        "summarise",
        "summarize"
      ],
      "fallback_command": "compact"
    },
    "transcript": {
      "schema_version": 1,
      "thought": {
        "variant": "signal",
        "density": "compact",
        "active_label": "Working…",
        "current_surface": "soft"
      }
    },
    "features": []
  },
  "runtime": {
    "driver_schema": 1,
    "protocol": "agent-client-protocol-1.3",
    "entrypoint": "agy-launch",
    "behavior": {
      "schema_version": 1,
      "permission": "portable_v1",
      "session": "portable_v1",
      "turn_end": "portable_v1",
      "configuration": "portable_v1",
      "default_preferences": {},
      "error_rules": []
    },
    "arguments": [
      "acp",
      "--disable-telemetry"
    ],
    "environment": {},
    "remove_environment": [
      "DBUS_SESSION_BUS_ADDRESS",
      "XDG_RUNTIME_DIR",
      "GOOGLE_API_KEY",
      "GOOGLE_APPLICATION_CREDENTIALS",
      "GOOGLE_CLOUD_PROJECT"
    ],
    "remove_environment_prefixes": [
      "AGY_",
      "ANTIGRAVITY_",
      "GEMINI_"
    ],
    "dependencies": [
      {
        "id": "cowboy-antigravity-launch",
        "version": "1.1.0",
        "source": "cowboy:components/provider-runtime/packages/antigravity-launch",
        "integrity": "sha256:9fdbd1bba97f4af5cf20c9c789d06b99abaac9664b4c93798080fce60fa304c4",
        "private": true
      },
      {
        "id": "google-antigravity-cli",
        "version": "1.5.9",
        "source": "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.9-4515810895593472/",
        "integrity": "sha256:471444ebaa846d5075cf636149d8fbf544bb7b81fc36a041437d8930ab21b475",
        "private": true
      }
    ],
    "platforms": [
      {
        "os": "linux",
        "architecture": "x86_64",
        "payload_digest": "",
        "launch_command": "agy-launch",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "antigravity",
            "dependency": "google-antigravity-cli",
            "command": "antigravity"
          },
          {
            "kind": "provider_adapter",
            "slot": "antigravity",
            "dependency": "cowboy-antigravity-launch",
            "command": "agy-launch"
          }
        ]
      }
    ],
    "required_capabilities": [
      "provider.runtime.v1",
      "provider.native-custody.v1"
    ],
    "network": "ipv4_only_v1",
    "isolation": "account_sandbox_v1"
  },
  "authentication": {
    "schema_version": 1,
    "required": true,
    "portable_schema": "antigravity-auth-v1",
    "projection_schema": "antigravity-home-v1",
    "refresh": "compare_and_swap",
    "methods": [
      {
        "id": "google-account",
        "label": "Google account",
        "flow": "browser_code",
        "executor": {
          "kind": "command_v1",
          "component": {
            "kind": "provider_adapter",
            "slot": "antigravity"
          },
          "arguments": [
            "--cowboy-login"
          ],
          "terminal": "pipes",
          "challenge": "browser_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": [
          "oauth_token"
        ]
      },
      {
        "id": "google-subscription",
        "label": "Personal Google account",
        "flow": "browser_code",
        "native_identity": {
          "kind": "owner_declared_v1",
          "authority": "google"
        },
        "native_logout": {
          "kind": "command_v1",
          "arguments": [
            "--cowboy-logout"
          ]
        },
        "executor": {
          "kind": "command_v1",
          "component": {
            "kind": "provider_adapter",
            "slot": "antigravity"
          },
          "arguments": [
            "--cowboy-login"
          ],
          "terminal": "pipes",
          "challenge": "browser_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": [
          "oauth_token"
        ]
      }
    ],
    "credential_files": [
      {
        "bundle_key": "oauth_token",
        "relative_path": ".gemini/antigravity-cli/antigravity-oauth-token",
        "required": false
      }
    ],
    "environment_projection": {}
  },
  "compatibility": {
    "min_controller_contract": 2,
    "max_controller_contract": 2,
    "min_machine_contract": 4,
    "max_machine_contract": 4,
    "ui_component_fingerprint": "",
    "auth_contract_fingerprint": ""
  }
}
