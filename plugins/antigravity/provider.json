        "Lifting off",
        "Defying gravity",
        "Floating ideas",
        "Charting orbits",
        "Gliding through code",
        "Weightless thinking",
        "Ascending",
        "Landing softly",
        "Working"
      ],
      "interval_ms": 3600,
      "suffix": "…",
      "effect": "shimmer"
    },
    "accessible_label": "Antigravity is working"
  },
  "configuration_presets": [
    {
      "id": "gemini-neon-high",
      "name": "Gemini 4 Neon · High",
      "detail": "Gemini 4 Neon · High thinking · strongest",
      "is_default": true,
      "values": {
        "model": "gemini-4-neon",
        "thought_level": "high"
      }
    },
    {
      "id": "gemini-neon-xhigh",
      "name": "Gemini 4 Neon · Extra",
      "detail": "Gemini 4 Neon · Extra thinking",
      "is_default": false,
      "values": {
