        "thought_level": "xhigh"
      }
    },
    {
      "id": "gemini-hydrogen-xhigh",
      "name": "Gemini 4 Hydrogen · Extra",
      "detail": "Gemini 4 Hydrogen · Extra thinking",
      "is_default": false,
      "values": {
        "model": "gemini-4-hydrogen",
        "thought_level": "xhigh"
      }
    },
    {
      "id": "gemini-hydrogen-high",
      "name": "Gemini 4 Hydrogen · High",
      "detail": "Gemini 4 Hydrogen · High thinking · daily",
      "is_default": false,
      "values": {
        "model": "gemini-4-hydrogen",
        "thought_level": "high"
      }
    },
    {
      "id": "claude-opus-high",
      "name": "Claude Opus 5.5 · High",
      "detail": "Claude Opus 5.5 · High thinking · on the Google account's quota",
      "is_default": false,
      "values": {
        "model": "claude-opus-5-5",
        "thought_level": "high"
      }
    },
    {
      "id": "claude-sonnet-high",
      "name": "Claude Sonnet 5.5 · High",
      "detail": "Claude Sonnet 5.5 · High thinking · on the Google account's quota",
      "is_default": false,
      "values": {
        "model": "claude-sonnet-5-5",
        "thought_level": "high"
      }
    }
  ],
  "host": {
    "schema_version": 2,
    "conversation_compaction": {
      "aliases": [
        "compact",
        "summarise",
        "summarize"
      ],
      "fallback_command": "compact"
    },
    "account_usage": {
      "provider": "antigravity"
    },
    "transcript": {
      "schema_version": 1,
      "thought": {
        "variant": "signal",
        "density": "compact",
        "active_label": "Working…",
        "current_surface": "soft"
      }
    },
    "features": []
  },
  "runtime": {
    "driver_schema": 1,
    "protocol": "agent-client-protocol-1.3",
    "entrypoint": "agy-launch",
    "behavior": {
      "schema_version": 1,
      "permission": "portable_v1",
      "session": "portable_v1",
      "turn_end": "portable_v1",
      "configuration": "portable_v1",
      "default_preferences": {
        "model": "gemini-4-neon",
        "thought_level": "high"
      },
      "error_rules": [
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:verification_required"
          },
          "user_detail": "Google asks to verify this Antigravity account. Verify it in the account's browser before continuing.",
          "classification": "antigravity-verification-required",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:location_unsupported"
          },
          "user_detail": "Google refused this Antigravity account: the service is not available in the runtime Machine's location.",
          "classification": "antigravity-location-unsupported",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:rate_limited"
          },
          "user_detail": "Google rate-limited this Antigravity account. Wait for the limit to reset before sending again.",
          "classification": "antigravity-rate-limited",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:suspended"
          },
          "user_detail": "Google reported this Antigravity account as suspended.",
          "classification": "antigravity-suspended",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:unknown_refusal"
          },
          "user_detail": "Cowboy could not prove Google's outcome for this turn from the account's log. Review the account before continuing.",
          "classification": "antigravity-unknown-refusal",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "all",
            "values": [
              {
                "op": "contains",
                "value": "antigravity_prompt_rejected:image_answer"
              },
              {
                "op": "contains",
                "value": "\"not_dispatched\""
              }
            ]
          },
          "user_detail": "Antigravity is waiting for your answer to its question, and images can't answer it. Nothing was sent to Google. Reply in text first, then send the images.",
          "classification": "antigravity-prompt-rejected",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_policy_violation:"
          },
          "user_detail": "A built-in Antigravity tool ran despite Cowboy's gate. The turn was ended and the account's units are being stopped; review the account before continuing.",
          "classification": "antigravity-policy-violation",
          "keep_worker_alive": true
        }
      ],
      "execution": {
        "interface": "jsonrpc_v1",
        "executor_digests": [
          "sha256:8bf204b36a2f6dd0dab73aa2f639892e67ef9ac8befccb4a05b1496ebf25c479"
        ]
      }
    },
    "arguments": [
      "acp",
      "--disable-telemetry"
    ],
    "managed_profiles": {
      "read_only_v1": {
        "arguments": [
          "acp",
          "--disable-telemetry",
          "--cowboy-managed-profile=read-only-v1",
          "--cowboy-output-contract=v1"
        ]
      }
    },
    "environment": {},
    "remove_environment": [
      "DBUS_SESSION_BUS_ADDRESS",
      "XDG_RUNTIME_DIR",
      "GOOGLE_API_KEY",
      "GOOGLE_APPLICATION_CREDENTIALS",
      "GOOGLE_CLOUD_PROJECT"
    ],
    "remove_environment_prefixes": [
      "AGY_",
      "ANTIGRAVITY_",
      "GEMINI_"
    ],
    "dependencies": [
      {
        "id": "cowboy-antigravity-launch",
        "version": "1.1.2",
        "source": "cowboy:components/provider-runtime/packages/antigravity-launch",
        "integrity": "sha256:0bb166ed52e0ed76af99307d90cd233d7a28296200458305bae828cac6f39918",
        "private": true
      },
      {
        "id": "cowboy-antigravity-acp",
        "version": "1.0.29",
        "source": "cowboy:components/provider-runtime/packages/antigravity-acp",
        "integrity": "sha256:47e20c798e3753e31f65bb06d49704a957b2ace6763495ede8e2559314c56db8",
        "private": true
      },
      {
        "id": "google-antigravity-cli",
        "version": "1.5.14",
        "source": "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.14-5302690847260672/",
        "integrity": "sha256:498e1ac7a9cfe2e1e566e9f929f5f6fec917ffbe99443189306435f955b95c9b",
        "private": true
      }
    ],
    "platforms": [
      {
        "os": "linux",
        "architecture": "x86_64",
        "payload_digest": "",
        "launch_command": "agy-launch",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "antigravity",
            "dependency": "google-antigravity-cli",
            "command": "antigravity"
          },
          {
            "kind": "provider_adapter",
            "slot": "antigravity",
            "dependency": "cowboy-antigravity-launch",
            "command": "agy-launch"
          },
          {
            "kind": "provider_adapter",
            "slot": "antigravity-proxy",
            "dependency": "cowboy-antigravity-acp",
            "command": "agy-proxy"
          }
        ]
      }
    ],
    "required_capabilities": [
      "provider.runtime.v1",
      "provider.execution-jsonrpc.v1",
      "provider.mcp-bindings.v1",
      "provider.native-custody.v1",
      "provider.managed-profiles.v1"
    ],
    "network": "ipv4_only_v1",
    "isolation": "account_sandbox_v1"
  },
  "authentication": {
    "schema_version": 1,
    "required": true,
    "portable_schema": "antigravity-auth-v1",
    "projection_schema": "antigravity-home-v1",
    "refresh": "compare_and_swap",
    "methods": [
      {
        "id": "google-account",
        "label": "Google account",
        "flow": "browser_code",
        "executor": {
          "kind": "command_v1",
          "component": {
            "kind": "provider_adapter",
            "slot": "antigravity"
          },
          "arguments": [
            "--cowboy-login"
          ],
          "terminal": "pipes",
          "challenge": "browser_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": [
          "oauth_token"
        ]
      },
      {
        "id": "google-subscription",
        "label": "Personal Google account",
        "flow": "browser_code",
        "native_identity": {
          "kind": "owner_declared_v1",
          "authority": "google"
        },
        "native_logout": {
          "kind": "command_v1",
          "arguments": [
            "--cowboy-logout"
          ]
        },
        "executor": {
          "kind": "command_v1",
          "component": {
            "kind": "provider_adapter",
            "slot": "antigravity"
          },
          "arguments": [
            "--cowboy-login"
          ],
          "terminal": "pipes",
          "challenge": "browser_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": [
          "oauth_token"
        ]
      }
    ],
    "credential_files": [
      {
        "bundle_key": "oauth_token",
        "relative_path": ".gemini/antigravity-cli/antigravity-oauth-token",
        "required": false
      }
    ],
    "environment_projection": {}
  },
  "compatibility": {
    "min_controller_contract": 2,
    "max_controller_contract": 2,
    "min_machine_contract": 4,
    "max_machine_contract": 4,
    "ui_component_fingerprint": "",
    "auth_contract_fingerprint": ""
  }
}
