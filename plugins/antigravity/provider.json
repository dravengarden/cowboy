{
  "authoring_schema": 2,
  "id": "antigravity",
  "version": "0.2.6",
  "publisher": "cowboy-first-party",
  "sdk_version": "3.7.0",
  "display": {
    "name": "Antigravity",
    "vendor": "Google",
    "summary": "Official Antigravity CLI with a personal Google account (not Google-supported in Cowboy)",
    "accent": "#4285F4",
    "secondary_accent": "#34A853",
    "mark_view_box": "0 0 24 24",
    "mark_path": "M1.5 21.5C4.5 21.3 6.3 17.5 7.6 13.6L10.1 5.9C10.5 4.6 11.2 3.6 12 3.6C12.8 3.6 13.5 4.6 13.9 5.9L16.4 13.6C17.7 17.5 19.5 21.3 22.5 21.5L18.2 21.5C16.6 20.6 15.4 18.2 14.4 15.2L12.6 9.8C12.45 9.35 12.25 9.1 12 9.1C11.75 9.1 11.55 9.35 11.4 9.8L9.6 15.2C8.6 18.2 7.4 20.6 5.8 21.5Z",
    "mark_gradient": {
      "x1_percent": 0,
      "y1_percent": 0,
      "x2_percent": 100,
      "y2_percent": 0,
      "stops": [
        {
          "offset_percent": 0,
          "color": "#4285F4"
        },
        {
          "offset_percent": 30,
          "color": "#34A853"
        },
        {
          "offset_percent": 50,
          "color": "#FBBC04"
        },
        {
          "offset_percent": 70,
          "color": "#EA4335"
        },
        {
          "offset_percent": 100,
          "color": "#7B61FF"
        }
      ]
    }
  },
  "card_layout": "mark_leading",
  "activity": {
    "indicator": {
      "kind": "mark_levitate",
      "interval_ms": 2600
    },
    "label": {
      "kind": "phrase_cycle",
      "phrases": [
        "Lifting off",
        "Defying gravity",
        "Floating ideas",
        "Charting orbits",
        "Gliding through code",
        "Weightless thinking",
        "Ascending",
        "Landing softly",
        "Working"
      ],
      "interval_ms": 3600,
      "suffix": "…",
      "effect": "shimmer"
    },
    "accessible_label": "Antigravity is working"
  },
  "configuration_presets": [
    {
      "id": "gemini-neon-high",
      "name": "Gemini 4 Neon · High",
      "detail": "Gemini 4 Neon · High thinking · strongest",
      "is_default": false,
      "values": {
        "model": "gemini-4-neon",
        "thought_level": "high"
      }
    },
    {
      "id": "gemini-hydrogen-xhigh",
      "name": "Gemini 4 Hydrogen · Extra",
      "detail": "Gemini 4 Hydrogen · Extra thinking",
      "is_default": false,
      "values": {
        "model": "gemini-4-hydrogen",
        "thought_level": "xhigh"
      }
    },
    {
      "id": "gemini-hydrogen-high",
      "name": "Gemini 4 Hydrogen · High",
      "detail": "Gemini 4 Hydrogen · High thinking · daily",
      "is_default": true,
      "values": {
        "model": "gemini-4-hydrogen",
        "thought_level": "high"
      }
    }
  ],
  "host": {
    "schema_version": 2,
    "conversation_compaction": {
      "aliases": [
        "compact",
        "summarise",
        "summarize"
      ],
      "fallback_command": "compact"
    },
    "transcript": {
      "schema_version": 1,
      "thought": {
        "variant": "signal",
        "density": "compact",
        "active_label": "Working…",
        "current_surface": "soft"
      }
    },
    "features": []
  },
  "runtime": {
    "driver_schema": 1,
    "protocol": "agent-client-protocol-1.3",
    "entrypoint": "agy-launch",
    "behavior": {
      "schema_version": 1,
      "permission": "portable_v1",
      "session": "portable_v1",
      "turn_end": "portable_v1",
      "configuration": "portable_v1",
      "default_preferences": {},
      "error_rules": [
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:verification_required"
          },
          "user_detail": "Google asks to verify this Antigravity account. Verify it in the account's browser before continuing.",
          "classification": "antigravity-verification-required",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:location_unsupported"
          },
          "user_detail": "Google refused this Antigravity account: the service is not available in the runtime Machine's location.",
          "classification": "antigravity-location-unsupported",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:rate_limited"
          },
          "user_detail": "Google rate-limited this Antigravity account. Wait for the limit to reset before sending again.",
          "classification": "antigravity-rate-limited",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:suspended"
          },
          "user_detail": "Google reported this Antigravity account as suspended.",
          "classification": "antigravity-suspended",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_backend_refusal:unknown_refusal"
          },
          "user_detail": "Cowboy could not prove Google's outcome for this turn from the account's log. Review the account before continuing.",
          "classification": "antigravity-unknown-refusal",
          "keep_worker_alive": true
        },
        {
          "when": {
            "op": "contains",
            "value": "antigravity_policy_violation:"
          },
          "user_detail": "A built-in Antigravity tool ran despite Cowboy's gate. The turn was ended and the account's units are being stopped; review the account before continuing.",
          "classification": "antigravity-policy-violation",
          "keep_worker_alive": true
        }
      ],
      "execution": {
        "interface": "jsonrpc_v1",
        "executor_digests": [
          "sha256:8bf204b36a2f6dd0dab73aa2f639892e67ef9ac8befccb4a05b1496ebf25c479"
        ]
      }
    },
    "arguments": [
      "acp",
      "--disable-telemetry"
    ],
    "environment": {},
    "remove_environment": [
      "DBUS_SESSION_BUS_ADDRESS",
      "XDG_RUNTIME_DIR",
      "GOOGLE_API_KEY",
      "GOOGLE_APPLICATION_CREDENTIALS",
      "GOOGLE_CLOUD_PROJECT"
    ],
    "remove_environment_prefixes": [
      "AGY_",
      "ANTIGRAVITY_",
      "GEMINI_"
    ],
    "dependencies": [
      {
        "id": "cowboy-antigravity-launch",
        "version": "1.1.0",
        "source": "cowboy:components/provider-runtime/packages/antigravity-launch",
        "integrity": "sha256:9d885248a15f644f6d83dd0cf16dbeb62395f2d3d09dbaa065ae4cb7968d2119",
        "private": true
      },
      {
        "id": "cowboy-antigravity-acp",
        "version": "1.0.4",
        "source": "cowboy:components/provider-runtime/packages/antigravity-acp",
        "integrity": "sha256:16c75003d0d40d9acd1dc91a8817af487ced30f5924f04003cf02519bf4e86ab",
        "private": true
      },
      {
        "id": "google-antigravity-cli",
        "version": "1.5.9",
        "source": "https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.9-4515810895593472/",
        "integrity": "sha256:471444ebaa846d5075cf636149d8fbf544bb7b81fc36a041437d8930ab21b475",
        "private": true
      }
    ],
    "platforms": [
      {
        "os": "linux",
        "architecture": "x86_64",
        "payload_digest": "",
        "launch_command": "agy-launch",
        "private_components": [
          {
            "kind": "provider_cli",
            "slot": "antigravity",
            "dependency": "google-antigravity-cli",
            "command": "antigravity"
          },
          {
            "kind": "provider_adapter",
            "slot": "antigravity",
            "dependency": "cowboy-antigravity-launch",
            "command": "agy-launch"
          },
          {
            "kind": "provider_adapter",
            "slot": "antigravity-proxy",
            "dependency": "cowboy-antigravity-acp",
            "command": "agy-proxy"
          }
        ]
      }
    ],
    "required_capabilities": [
      "provider.runtime.v1",
      "provider.execution-jsonrpc.v1",
      "provider.native-custody.v1"
    ],
    "network": "ipv4_only_v1",
    "isolation": "account_sandbox_v1"
  },
  "authentication": {
    "schema_version": 1,
    "required": true,
    "portable_schema": "antigravity-auth-v1",
    "projection_schema": "antigravity-home-v1",
    "refresh": "compare_and_swap",
    "methods": [
      {
        "id": "google-account",
        "label": "Google account",
        "flow": "browser_code",
        "executor": {
          "kind": "command_v1",
          "component": {
            "kind": "provider_adapter",
            "slot": "antigravity"
          },
          "arguments": [
            "--cowboy-login"
          ],
          "terminal": "pipes",
          "challenge": "browser_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": [
          "oauth_token"
        ]
      },
      {
        "id": "google-subscription",
        "label": "Personal Google account",
        "flow": "browser_code",
        "native_identity": {
          "kind": "owner_declared_v1",
          "authority": "google"
        },
        "native_logout": {
          "kind": "command_v1",
          "arguments": [
            "--cowboy-logout"
          ]
        },
        "executor": {
          "kind": "command_v1",
          "component": {
            "kind": "provider_adapter",
            "slot": "antigravity"
          },
          "arguments": [
            "--cowboy-login"
          ],
          "terminal": "pipes",
          "challenge": "browser_code",
          "environment": {},
          "preflight": []
        },
        "required_bundle_keys": [
          "oauth_token"
        ]
      }
    ],
    "credential_files": [
      {
        "bundle_key": "oauth_token",
        "relative_path": ".gemini/antigravity-cli/antigravity-oauth-token",
        "required": false
      }
    ],
    "environment_projection": {}
  },
  "compatibility": {
    "min_controller_contract": 2,
    "max_controller_contract": 2,
    "min_machine_contract": 4,
    "max_machine_contract": 4,
    "ui_component_fingerprint": "",
    "auth_contract_fingerprint": ""
  }
}
