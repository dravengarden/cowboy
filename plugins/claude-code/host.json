{
  "schema_version": 1,
  "adapter_slot": "claude",
  "cli_executable": "claude",
  "cli_executable_env": "CLAUDE_CODE_EXECUTABLE",
  "cli_auth": "exit",
  "cli_auth_argv": [
    "auth",
    "status",
    "--json"
  ],
  "visual": {
    "light": {
      "primary": "#C65D3A",
      "secondary": "#9A4A30"
    },
    "dark": {
      "primary": "#E08A6A",
      "secondary": "#D97757"
    }
  },
  "slots": [
    "provider.usage",
    "provider.setup",
    "provider.empty",
    "provider.settings"
  ],
  "ui": {
    "schema_version": 1,
    "renderers": {
      "provider.usage": "provider-usage-v1",
      "provider.setup": "provider-surface-v1",
      "provider.empty": "provider-surface-v1",
      "provider.settings": "provider-surface-v1"
    }
  },
  "usage": {
    "account": "anthropic",
    "collector": "command",
    "collector_argv": [
      "@plugin-js",
      "run",
      "--quiet",
      "--no-prompt",
      "--allow-env=COWBOY_PLUGIN_COMMAND_CLAUDE,CLAUDE_CODE_EXECUTABLE,CLAUDE_SECURESTORAGE_CONFIG_DIR,HOME,PATH,TMPDIR,USER,XDG_CONFIG_HOME,XDG_DATA_HOME,XDG_CACHE_HOME,SSL_CERT_FILE,NIX_SSL_CERT_FILE",
      "--allow-run=claude,${ENV:COWBOY_PLUGIN_COMMAND_CLAUDE},${ENV:CLAUDE_CODE_EXECUTABLE}",
      "${PLUGIN_DIR}/collector/index.js"
    ],
    "session_rate_limits": {
      "pointer": "/_meta/_claude~1rateLimit",
      "target": "rateLimits",
      "required_number_fields": [
        "utilization"
      ],
      "required_string_fields": [
        "rateLimitType"
      ]
    },
    "product": "Anthropic",
    "error_auth": "Anthropic account status expired. Sign in to Claude Code again.",
    "error_fetch": "Claude Code could not refresh Anthropic usage.",
    "order": 0,
    "top_bar_windows": [
      300,
      10080
    ],
    "widget": "anthropic-weekly",
    "widget_shape": "percent",
    "widget_window": 10080,
    "empty": "Plan usage is unavailable. Refresh to try again.",
    "limit_id_prefix": "claude",
    "limit_labels": [
      {
        "id": "five_hour",
        "label": "5h",
        "window_minutes": 300
      },
      {
        "id": "seven_day",
        "label": "Weekly",
        "window_minutes": 10080
      },
      {
        "id": "seven_day_opus",
        "label": "Opus · Weekly",
        "window_minutes": 10080
      },
      {
        "id": "seven_day_sonnet",
        "label": "Sonnet · Weekly",
        "window_minutes": 10080
      },
      {
        "id": "seven_day_overage_included",
        "label": "Extra usage · Weekly",
        "window_minutes": 10080
      },
      {
        "id": "overage",
        "label": "Extra usage"
      }
    ]
  }
}
