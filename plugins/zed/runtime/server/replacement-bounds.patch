 impl language::LocalFile for File {
+    fn cowboy_load_bytes(
+        &self,
+        job: language::cowboy_replacement::Job,
+        cx: &App,
+    ) -> Task<Result<language::cowboy_replacement::Held<Vec<u8>>>> {
+        let worktree = self.worktree.read(cx).as_local().unwrap();
+        let abs_path = worktree.absolutize(&self.path);
+        let fs = worktree.fs.clone();
+        cx.background_spawn(async move {
+            let result = fs.cowboy_load_bytes_bounded(&abs_path, 4 * 1024 * 1024).await;
+            result.map(|bytes| job.hold(bytes))
+        })
+    }
+
     fn abs_path(&self, cx: &App) -> PathBuf {
         self.worktree.read(cx).absolutize(&self.path)
     }
