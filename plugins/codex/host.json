{
  "schema_version": 1,
  "adapter_slot": "codex",
  "cli_auth": "exit",
  "cli_auth_argv": ["login", "status"],
  "visual": {
    "light": { "primary": "#3B5BDB", "secondary": "#0F766E" },
    "dark": { "primary": "#8EA2FF", "secondary": "#2DD4BF" }
  },
  "slots": [
    "provider.usage",
    "provider.setup",
    "provider.empty",
    "provider.settings"
  ],
  "ui": {
    "schema_version": 1,
    "renderers": {
      "provider.usage": "provider-usage-v1",
      "provider.setup": "provider-surface-v1",
      "provider.empty": "provider-surface-v1",
      "provider.settings": "provider-surface-v1"
    }
  },
  "usage": {
    "account": "openai",
    "collector": "command",
    "collector_argv": [
      "@plugin-js",
      "run",
      "--quiet",
      "--no-prompt",
      "--allow-env=COWBOY_PLUGIN_COMMAND_CODEX,COWBOY_CODEX_COMMAND",
      "--allow-run=codex,${ENV:COWBOY_PLUGIN_COMMAND_CODEX},${ENV:COWBOY_CODEX_COMMAND}",
      "${PLUGIN_DIR}/collector/index.js"
    ],
    "reset": "codex",
    "reset_argv": [
      "@plugin-js",
      "run",
      "--quiet",
      "--no-prompt",
      "--allow-env=COWBOY_PLUGIN_COMMAND_CODEX,COWBOY_CODEX_COMMAND",
      "--allow-run=codex,${ENV:COWBOY_PLUGIN_COMMAND_CODEX},${ENV:COWBOY_CODEX_COMMAND}",
      "${PLUGIN_DIR}/collector/index.js"
    ],
    "product": "OpenAI",
    "error_auth": "OpenAI usage authorization expired. Sign in to Codex again.",
    "order": 0,
    "top_bar_windows": [300, 10080],
    "widget": "openai-weekly",
    "widget_shape": "percent",
    "widget_window": 10080
  }
}
