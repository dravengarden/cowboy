diff --git a/src/__tests__/CowboyStdUtils.test.ts b/src/__tests__/CowboyStdUtils.test.ts
--- /dev/null
+++ b/src/__tests__/CowboyStdUtils.test.ts
@@ -0,0 +1,100 @@
+import {PassThrough} from 'node:stream';
+import {describe, expect, it} from 'vitest';
+import {createJSONRPCReader} from '../StdUtils';
+import type {ResponseMessage} from 'vscode-jsonrpc/node';
+
+describe('App Server JSON frames', () => {
+    it('preserves Unicode and multiple frames across every byte boundary', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        const received: unknown[] = [];
+        reader.listen(message => received.push(message));
+        const frame = Buffer.from('\r\n' + JSON.stringify({id: 1, result: '图标🦅'}) + '\r\n' +
+            JSON.stringify({id: 2, result: {path: '/space here/a.png'}}) + '\n');
+        for (const byte of frame) stream.write(Buffer.from([byte]));
+        expect(received).toEqual([
+            {jsonrpc: '2.0', id: 1, result: '图标🦅'},
+            {jsonrpc: '2.0', id: 2, result: {path: '/space here/a.png'}},
+        ]);
+        reader.dispose();
+        stream.destroy();
+    });
+
+    it.each([
+        Buffer.from('{"secret":"not valid JSON"\n'),
+        Buffer.from([123, 34, 120, 34, 58, 34, 255, 34, 125, 10]),
+        Buffer.from('[]\n'),
+    ])('closes malformed input without exposing payloads', frame => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        const errors: string[] = [];
+        let closed = 0;
+        let received = 0;
+        reader.onError(error => errors.push(error.message));
+        reader.onClose(() => closed++);
+        reader.listen(() => received++);
+        stream.write(frame);
+        expect(errors).toEqual(['App Server returned an invalid UTF-8 or JSON frame']);
+        expect(closed).toBe(1);
+        expect(received).toBe(0);
+        expect(stream.destroyed).toBe(true);
+        reader.dispose();
+    });
+
+    it('bounds an unterminated frame before allocating the entire response', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream, 64);
+        const errors: string[] = [];
+        reader.onError(error => errors.push(error.message));
+        reader.listen(() => { throw new Error('Oversized input must not be delivered'); });
+        stream.write(Buffer.alloc(32, 32));
+        stream.write(Buffer.alloc(33, 32));
+        expect(errors).toEqual(['App Server JSON frame exceeds the supported byte limit']);
+        expect(stream.destroyed).toBe(true);
+        reader.dispose();
+    });
+
+    it('reports EOF during a frame and resolves clean EOF once', async () => {
+        for (const incomplete of [false, true]) {
+            const stream = new PassThrough();
+            const reader = createJSONRPCReader(stream);
+            const errors: string[] = [];
+            let closes = 0;
+            reader.onError(error => errors.push(error.message));
+            const closed = new Promise<void>(resolve => reader.onClose(() => { closes++; resolve(); }));
+            reader.listen(() => {});
+            stream.end(incomplete ? '{' : '{}\n');
+            await closed;
+            expect(closes).toBe(1);
+            expect(errors).toEqual(incomplete ? ['App Server closed with an incomplete JSON frame'] : []);
+            reader.dispose();
+        }
+    });
+
+    it('releases retained fragments and listeners when disposed', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        let received = 0;
+        reader.listen(() => received++);
+        stream.write(Buffer.from('{'));
+        reader.dispose();
+        stream.write(Buffer.from('}\n'));
+        expect(received).toBe(0);
+        for (const event of ['data', 'error', 'end', 'close']) expect(stream.listenerCount(event)).toBe(0);
+        stream.destroy();
+    });
+
+    it('handles a large image result supplied in small chunks', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        let length = 0;
+        reader.listen(message => { length = ((message as ResponseMessage).result as string).length; });
+        stream.write('{"id":1,"result":"');
+        const chunk = Buffer.alloc(1024, 65);
+        for (let index = 0; index < 32 * 1024; index++) stream.write(chunk);
+        stream.write('"}\n');
+        expect(length).toBe(32 * 1024 * 1024);
+        reader.dispose();
+        stream.destroy();
+    });
+});
