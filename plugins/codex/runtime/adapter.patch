+import {EventEmitter} from 'node:events';
+import {PassThrough} from 'node:stream';
+import {afterEach, expect, it, vi} from 'vitest';
+import {spawn} from 'node:child_process';
+import type {ChildProcessWithoutNullStreams} from 'node:child_process';
+import {startCodexConnection} from '../CodexJsonRpcConnection';
+
+vi.mock('node:child_process', () => ({spawn: vi.fn()}));
+afterEach(() => vi.clearAllMocks());
+
+function nativeProcess() {
+    const child = Object.assign(new EventEmitter(), {
+        stdin: new PassThrough(), stdout: new PassThrough(), stderr: new PassThrough(),
+        exitCode: null as number | null, signalCode: null as string | null,
+        kill: vi.fn(() => {
+            child.signalCode = 'SIGTERM';
+            child.emit('exit', null, 'SIGTERM');
+            return true;
+        }),
+    });
+    vi.mocked(spawn).mockReturnValue(child as unknown as ChildProcessWithoutNullStreams);
+    return child;
+}
+
+it('rejects a pending restore and terminates its native process on malformed output', async () => {
+    const child = nativeProcess();
+    const {connection} = startCodexConnection('/exact/codex', {
+        COWBOY_PRIVATE_CODEX_ARGUMENTS: '["-c","approval_policy=never"]',
+    });
+    expect(spawn).toHaveBeenCalledWith('/exact/codex', ['-c', 'approval_policy=never', 'app-server'], expect.anything());
+    const pending = connection.sendRequest('thread/resume', {threadId: 'kept-thread', excludeTurns: true});
+    const rejected = expect(pending).rejects.toThrow('disposed');
+    child.stdout.write('{invalid\n');
+    await rejected;
+    expect(child.kill).toHaveBeenCalledOnce();
+    child.stdin.destroy();
+    child.stderr.destroy();
+});
+
+it('stops the native process and still reports drained output to a supervising owner', async () => {
+    for (const output of ['{"method":"kept"}\n{', '{bad\n']) {
+        const child = nativeProcess();
+        const {connection, drained} = startCodexConnection('/exact/codex', {}, ['app-server'], {disposeOnExit: false});
+        const kept: unknown[] = [];
+        connection.onNotification('kept', () => { kept.push(true); });
+        const pending = connection.sendRequest('thread/resume', {threadId: 'kept-thread', excludeTurns: true});
+        pending.catch(() => {});
+        child.stdout.end(output);
+        if (output.endsWith('{')) {
+            // The marker follows the frames read before the incomplete one.
+            await drained;
+            expect(kept).toEqual([true]);
+        } else {
+            await new Promise(resolve => setImmediate(resolve));
+        }
+        expect(child.kill).toHaveBeenCalledOnce();
+        // No new request starts on a stream that lost a frame; the owner disposes after the exit.
+        expect(() => connection.sendRequest('thread/list', {})).toThrow('closed');
+        connection.dispose();
+        await expect(pending).rejects.toThrow('disposed');
+        child.stdin.destroy();
+        child.stderr.destroy();
+    }
+});
+
+it('keeps the upstream startup arguments behind the private configuration', () => {
+    const child = nativeProcess();
+    const startup = ['app-server', '-c', 'hooks={ }'];
+    const {connection} = startCodexConnection('/exact/codex', {
+        COWBOY_PRIVATE_CODEX_ARGUMENTS: '["-c","approval_policy=never"]',
+    }, startup);
+    expect(spawn).toHaveBeenCalledWith('/exact/codex', ['-c', 'approval_policy=never', ...startup], expect.anything());
+    connection.dispose();
+    for (const stream of [child.stdin, child.stdout, child.stderr]) stream.destroy();
+});
+
+it('uses the owned execution bridge without replacing the native CLI binding', () => {
+    const child = nativeProcess();
+    const environment = {
+        COWBOY_PRIVATE_CODEX_ARGUMENTS: '[]',
+        COWBOY_EXECUTION_DESCRIPTOR: '/private/descriptor',
+        COWBOY_PRIVATE_CODEX_EXECUTABLE: '/exact/codex',
+        COWBOY_PRIVATE_CODEX_BRIDGE: '/exact/launcher.mjs',
+    };
+    const {connection} = startCodexConnection('/exact/codex', environment);
+    expect(spawn).toHaveBeenCalledWith(process.execPath,
+        ['/exact/launcher.mjs', '--cowboy-private-cli', 'app-server'], {env: environment});
+    connection.dispose();
+    for (const stream of [child.stdin, child.stdout, child.stderr]) stream.destroy();
+    for (const changed of [
+        {...environment, COWBOY_PRIVATE_CODEX_BRIDGE: ''},
+        {...environment, COWBOY_PRIVATE_CODEX_EXECUTABLE: '/different/codex'},
+    ]) expect(() => startCodexConnection('/exact/codex', changed)).toThrow('exact private bridge');
+});
