+import {afterEach, describe, expect, it} from "vitest";
+import {imageProfileActive, managedProfileActive, managedTurn, refuseManagedReconfiguration,
+    MANAGED_PROFILE_ENV, MANAGED_SANDBOX_POLICY} from "../CowboyManagedProfile";
+import {ImageGenerationReporter} from "../tool-calls/reporters/ImageGenerationReporter";
+
+afterEach(() => { delete process.env[MANAGED_PROFILE_ENV]; });
+
+describe("Cowboy native image profile", () => {
+    it("retains the same mandatory metadata and read-only execution fence", () => {
+        process.env[MANAGED_PROFILE_ENV] = "image-v1";
+        expect(imageProfileActive()).toBe(true);
+        expect(managedProfileActive()).toBe(true);
+        expect(MANAGED_SANDBOX_POLICY).toEqual({type:"readOnly", networkAccess:false});
+        expect(() => managedTurn({})).toThrow();
+        expect(() => refuseManagedReconfiguration()).toThrow();
+        expect(managedTurn({"cowboy.dev/managedCall":{callId:"c1",inputRevision:"revision",outputSchema:null}})?.callId).toBe("c1");
+    });
+
+    it("identifies generated images without duplicating bytes or rewriting native history", () => {
+        const item = {type:"imageGeneration" as const,id:"i1",status:"completed",result:"iVBORw0KGgo=",
+            revisedPrompt:null,failure:null,savedPath:"/runtime/generated.png"};
+        process.env[MANAGED_PROFILE_ENV] = "image-v1";
+        const report = ImageGenerationReporter.completed(item);
+        expect(report.standard?.rawOutput).toMatchObject({cowboyGeneratedImage:true,status:"completed"});
+        expect(report.standard?.rawOutput).not.toHaveProperty("result");
+        expect(report.standard?.content).toHaveLength(1);
+        expect(item.result).toBe("iVBORw0KGgo=");
+        delete process.env[MANAGED_PROFILE_ENV];
+        expect(ImageGenerationReporter.completed(item).standard?.rawOutput).toHaveProperty("result",item.result);
+    });
+});
