+import {EventEmitter} from 'node:events';
+import {PassThrough} from 'node:stream';
+import {afterEach, expect, it, vi} from 'vitest';
+import {spawn} from 'node:child_process';
+import type {ChildProcessWithoutNullStreams} from 'node:child_process';
+import {startCodexConnection} from '../CodexJsonRpcConnection';
+
+vi.mock('node:child_process', () => ({spawn: vi.fn()}));
+afterEach(() => vi.clearAllMocks());
+
+it('rejects a pending restore and terminates its native process on malformed output', async () => {
+    const child = Object.assign(new EventEmitter(), {
+        stdin: new PassThrough(), stdout: new PassThrough(), stderr: new PassThrough(),
+        exitCode: null, signalCode: null, kill: vi.fn(),
+    });
+    vi.mocked(spawn).mockReturnValue(child as unknown as ChildProcessWithoutNullStreams);
+    const {connection} = startCodexConnection('/exact/codex', {
+        COWBOY_PRIVATE_CODEX_ARGUMENTS: '["-c","approval_policy=never"]',
+    });
+    expect(spawn).toHaveBeenCalledWith('/exact/codex', ['-c', 'approval_policy=never', 'app-server'], expect.anything());
+    const pending = connection.sendRequest('thread/resume', {threadId: 'kept-thread', excludeTurns: true});
+    const rejected = expect(pending).rejects.toThrow('disposed');
+    child.stdout.write('{invalid\n');
+    await rejected;
+    expect(child.kill).toHaveBeenCalledOnce();
+    child.stdin.destroy();
+    child.stderr.destroy();
+});
