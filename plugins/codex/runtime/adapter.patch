diff --git a/src/CowboyManagedProfile.ts b/src/CowboyManagedProfile.ts
new file mode 100644
index 0000000..6703242
--- /dev/null
+++ b/src/CowboyManagedProfile.ts
@@ -0,0 +1,56 @@
+// Cowboy-owned managed read-only profile. The Provider launcher enables it
+// only for a signed managed launch; it never widens an ordinary session.
+import type {JsonValue} from "./app-server/serde_json/JsonValue";
+import type {SandboxPolicy} from "./app-server/v2";
+
+export const MANAGED_PROFILE_ENV = "COWBOY_PRIVATE_MANAGED_PROFILE";
+export const MANAGED_PROFILE = "read-only-v1";
+export const MANAGED_CALL_META_KEY = "cowboy.dev/managedCall";
+
+/** Every turn of a managed child: never ask, never write, no network. */
+export const MANAGED_SANDBOX_POLICY: SandboxPolicy = {type: "readOnly", networkAccess: false};
+
+export function managedProfileActive(): boolean {
+    return process.env[MANAGED_PROFILE_ENV] === MANAGED_PROFILE;
+}
+
+export interface ManagedTurn {
+    callId: string;
+    outputSchema: JsonValue | null;
+}
+
+/**
+ * Resolve the Cowboy turn metadata. A managed child refuses a turn without
+ * it, and an ordinary session refuses it rather than silently ignoring an
+ * output constraint it cannot enforce.
+ */
+export function managedTurn(meta: unknown): ManagedTurn | null {
+    const entry = meta !== null && typeof meta === "object"
+        ? (meta as Record<string, unknown>)[MANAGED_CALL_META_KEY]
+        : undefined;
+    if (!managedProfileActive()) {
+        if (entry !== undefined) {
+            throw new Error("Managed call metadata requires the managed read-only profile");
+        }
+        return null;
+    }
+    if (entry === null || typeof entry !== "object" || Array.isArray(entry)) {
+        throw new Error("Managed read-only turn is missing its Cowboy call metadata");
+    }
+    const value = entry as Record<string, unknown>;
+    const callId = value["callId"];
+    const schema = value["outputSchema"];
+    if (typeof callId !== "string" || callId.length === 0
+        || typeof value["inputRevision"] !== "string"
+        || (schema !== null && schema !== undefined
+            && (typeof schema !== "object" || Array.isArray(schema)))) {
+        throw new Error("Managed read-only turn has invalid Cowboy call metadata");
+    }
+    return {callId, outputSchema: (schema ?? null) as JsonValue | null};
+}
+
+export function refuseManagedReconfiguration(): void {
+    if (managedProfileActive()) {
+        throw new Error("Managed read-only profile configuration is fixed");
+    }
+}
