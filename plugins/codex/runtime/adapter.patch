+import {afterEach, describe, expect, it} from "vitest";
+import {
+    MANAGED_CALL_META_KEY,
+    MANAGED_PROFILE_ENV,
+    managedTurn,
+    refuseManagedReconfiguration,
+} from "../CowboyManagedProfile";
+
+const meta = (value: unknown) => ({[MANAGED_CALL_META_KEY]: value});
+
+describe("Cowboy managed read-only profile", () => {
+    afterEach(() => {
+        delete process.env[MANAGED_PROFILE_ENV];
+    });
+
+    it("leaves ordinary sessions untouched and refuses managed metadata there", () => {
+        expect(managedTurn(undefined)).toBeNull();
+        expect(managedTurn({other: true})).toBeNull();
+        expect(() => managedTurn(meta({callId: "c", inputRevision: "r", outputSchema: null})))
+            .toThrow(/requires the managed/);
+        expect(() => refuseManagedReconfiguration()).not.toThrow();
+    });
+
+    it("requires per-turn metadata and forwards the native output schema", () => {
+        process.env[MANAGED_PROFILE_ENV] = "read-only-v1";
+        expect(() => managedTurn(undefined)).toThrow(/missing/);
+        expect(() => managedTurn(meta({callId: "c"}))).toThrow(/invalid/);
+        expect(() => managedTurn(meta({callId: "c", inputRevision: "r", outputSchema: []})))
+            .toThrow(/invalid/);
+        const schema = {type: "object", properties: {verdict: {type: "string"}}};
+        expect(managedTurn(meta({callId: "c", inputRevision: "r", outputSchema: schema})))
+            .toEqual({callId: "c", outputSchema: schema});
+        expect(managedTurn(meta({callId: "c", inputRevision: "r", outputSchema: null})))
+            .toEqual({callId: "c", outputSchema: null});
+        expect(() => refuseManagedReconfiguration()).toThrow(/fixed/);
+    });
+});
diff --git a/src/__tests__/CowboyStdUtils.test.ts b/src/__tests__/CowboyStdUtils.test.ts
new file mode 100644
index 0000000..b4065d6
--- /dev/null
+++ b/src/__tests__/CowboyStdUtils.test.ts
@@ -0,0 +1,119 @@
+import {PassThrough} from 'node:stream';
+import {describe, expect, it} from 'vitest';
+import {createJSONRPCReader} from '../StdUtils';
+import type {Message, ResponseMessage} from 'vscode-jsonrpc/node';
+
+describe('App Server JSON frames', () => {
+    it('preserves Unicode and multiple frames across every byte boundary', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        const received: unknown[] = [];
+        reader.listen(message => received.push(message));
+        const frame = Buffer.from('\r\n' + JSON.stringify({id: 1, result: '图标🦅'}) + '\r\n' +
+            JSON.stringify({id: 2, result: {path: '/space here/a.png'}}) + '\n');
+        for (const byte of frame) stream.write(Buffer.from([byte]));
+        expect(received).toEqual([
+            {jsonrpc: '2.0', id: 1, result: '图标🦅'},
+            {jsonrpc: '2.0', id: 2, result: {path: '/space here/a.png'}},
+        ]);
+        reader.dispose();
+        stream.destroy();
+    });
+
+    it.each([
+        Buffer.from('{"secret":"not valid JSON"\n'),
+        Buffer.from([123, 34, 120, 34, 58, 34, 255, 34, 125, 10]),
+        Buffer.from('[]\n'),
+    ])('closes malformed input without exposing payloads', frame => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        const errors: string[] = [];
+        let closed = 0;
+        let received = 0;
+        reader.onError(error => errors.push(error.message));
+        reader.onClose(() => closed++);
+        reader.listen(() => received++);
+        stream.write(frame);
+        expect(errors).toEqual(['App Server returned an invalid UTF-8 or JSON frame']);
+        expect(closed).toBe(1);
+        expect(received).toBe(0);
+        expect(stream.destroyed).toBe(true);
+        reader.dispose();
+    });
+
+    it('bounds an unterminated frame before allocating the entire response', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream, 64);
+        const errors: string[] = [];
+        reader.onError(error => errors.push(error.message));
+        reader.listen(() => { throw new Error('Oversized input must not be delivered'); });
+        stream.write(Buffer.alloc(32, 32));
+        stream.write(Buffer.alloc(33, 32));
+        expect(errors).toEqual(['App Server JSON frame exceeds the supported byte limit']);
+        expect(stream.destroyed).toBe(true);
+        reader.dispose();
+    });
+
+    it('reports EOF during a frame and leaves a clean EOF to the process owner', async () => {
+        for (const incomplete of [false, true]) {
+            const stream = new PassThrough();
+            const reader = createJSONRPCReader(stream);
+            const errors: string[] = [];
+            const received: unknown[] = [];
+            let closes = 0;
+            reader.onError(error => errors.push(error.message));
+            reader.onClose(() => closes++);
+            reader.listen(message => received.push(message));
+            const ended = new Promise<void>(resolve => stream.once('end', () => setImmediate(resolve)));
+            stream.end(incomplete ? '{' : '{}\n');
+            await ended;
+            expect(closes).toBe(incomplete ? 1 : 0);
+            expect(errors).toEqual(incomplete ? ['App Server closed with an incomplete JSON frame'] : []);
+            // The owner's end-of-output marker follows the frames read so far in both cases.
+            reader.deliver?.({jsonrpc: '2.0', method: 'marker'} as Message);
+            expect(received).toEqual([...(incomplete ? [] : [{jsonrpc: '2.0'}]), {jsonrpc: '2.0', method: 'marker'}]);
+            reader.dispose();
+            reader.deliver?.({jsonrpc: '2.0', method: 'late'} as Message);
+            expect(received).toHaveLength(incomplete ? 1 : 2);
+        }
+    });
+
+    it('delivers no frame after a failure', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        const received: unknown[] = [];
+        reader.onError(() => {});
+        reader.listen(message => received.push(message));
+        stream.write('{"id":1,"result":{}}\n{bad\n{"id":2,"result":{}}\n');
+        expect(received).toEqual([{jsonrpc: '2.0', id: 1, result: {}}]);
+        expect(() => reader.listen(() => {})).toThrow('not available');
+        reader.dispose();
+    });
+
+    it('releases retained fragments and listeners when disposed', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        let received = 0;
+        reader.listen(() => received++);
+        stream.write(Buffer.from('{'));
+        reader.dispose();
+        stream.write(Buffer.from('}\n'));
+        expect(received).toBe(0);
+        for (const event of ['data', 'error', 'end']) expect(stream.listenerCount(event)).toBe(0);
+        stream.destroy();
+    });
+
+    it('handles a large image result supplied in small chunks', () => {
+        const stream = new PassThrough();
+        const reader = createJSONRPCReader(stream);
+        let length = 0;
+        reader.listen(message => { length = ((message as ResponseMessage).result as string).length; });
+        stream.write('{"id":1,"result":"');
+        const chunk = Buffer.alloc(1024, 65);
+        for (let index = 0; index < 32 * 1024; index++) stream.write(chunk);
+        stream.write('"}\n');
+        expect(length).toBe(32 * 1024 * 1024);
+        reader.dispose();
+        stream.destroy();
+    });
+});
