+bool VNCServerST::touchSlots[VNCServerST::maxTouchContacts];
+
+int VNCServerST::claimTouchSlot()
+{
+  for (unsigned slot = 0; slot < maxTouchContacts; slot++) {
+    if (!touchSlots[slot]) {
+      touchSlots[slot] = true;
+      return slot;
+    }
+  }
+  return -1;
+}
+
+void VNCServerST::releaseTouchSlot(unsigned slot)
+{
+  if (slot < maxTouchContacts)
+    touchSlots[slot] = false;
+}
