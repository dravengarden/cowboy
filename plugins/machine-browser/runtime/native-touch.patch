+void VNCSConnectionST::supportsTouchEvents()
+{
+  if (!rfb::Server::acceptTouchEvents)
+    return;
+  touchEnabled = true;
+  writer()->writeTouchEventsSupported(VNCServerST::maxTouchContacts);
+}
+
+void VNCSConnectionST::touchEvent(int state, uint32_t id, const Point& pos)
+{
+  if (rfb::Server::idleTimeout)
+    idleTimer.start(secsToMillis(rfb::Server::idleTimeout));
+
+  std::map<uint32_t, ActiveTouch>::iterator touch = activeTouches.find(id);
+
+  // Without pointer permission nothing new is accepted, but what is down
+  // still ends (at its last accepted position), so no contact sticks.
+  if (!touchPermitted()) {
+    if (state == touchEventEnd && touch != activeTouches.end())
+      endTouch(touch);
+    else
+      releaseForbiddenTouches();
+    return;
+  }
+
+  // Clamp to the framebuffer
+  Point clamped(pos);
+  if (clamped.x >= client.width())
+    clamped.x = client.width() > 0 ? client.width() - 1 : 0;
+  if (clamped.y >= client.height())
+    clamped.y = client.height() > 0 ? client.height() - 1 : 0;
+
+  switch (state) {
+  case touchEventBegin: {
+    if (touch != activeTouches.end()) {
+      vlog.debug("Ignoring duplicate touch begin %u", id);
+      return;
+    }
+    int slot = server->claimTouchSlot();
+    if (slot < 0) {
+      vlog.debug("Ignoring touch begin %u: every contact is active", id);
+      return;
+    }
+    ActiveTouch active = { (unsigned)slot, clamped };
+    activeTouches[id] = active;
+    server->touchEvent(touchEventBegin, slot, clamped);
+    break;
+  }
+  case touchEventUpdate:
+    if (touch == activeTouches.end()) return;
+    touch->second.pos = clamped;
+    server->touchEvent(touchEventUpdate, touch->second.slot, clamped);
+    break;
+  case touchEventEnd:
+    if (touch == activeTouches.end()) return;
+    touch->second.pos = clamped;
+    endTouch(touch);
+    break;
+  }
+}
+
+bool VNCSConnectionST::touchPermitted()
+{
+  return accessCheck(AccessPtrEvents) && rfb::Server::acceptPointerEvents;
+}
+
+void VNCSConnectionST::endTouch(std::map<uint32_t, ActiveTouch>::iterator touch)
+{
+  ActiveTouch ended = touch->second;
+  activeTouches.erase(touch);
+  server->touchEvent(touchEventEnd, ended.slot, ended.pos);
+  server->releaseTouchSlot(ended.slot);
+}
+
+void VNCSConnectionST::releaseForbiddenTouches()
+{
+  if (activeTouches.empty() || touchPermitted())
+    return;
+  vlog.debug("Ending %zu touches: pointer input is no longer accepted",
+             activeTouches.size());
+  while (!activeTouches.empty())
+    endTouch(activeTouches.begin());
+}
