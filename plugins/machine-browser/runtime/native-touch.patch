+/*
+ * Native touch. Clients see an ordinary touchscreen laptop: the core
+ * pointer is typed as a mouse and a direct touch device with ten contacts
+ * sits beside it. Without the type atoms clients such as Chromium report no
+ * touch points and no pointer at all.
+ */
+#define VNC_TOUCH_CONTACTS 10
+#define VNC_TOUCH_AXIS_MAX 0xffff
+
+static int vncTouchProc(DeviceIntPtr pDevice, int onoff)
+{
+	DevicePtr pDev = (DevicePtr)pDevice;
+	BYTE map[2] = { 0, 1 };
+	Atom btn_labels[1];
+	Atom axes_labels[2];
+
+	switch (onoff) {
+	case DEVICE_INIT:
+		btn_labels[0] = XIGetKnownProperty(BTN_LABEL_PROP_BTN_LEFT);
+		axes_labels[0] = XIGetKnownProperty(AXIS_LABEL_PROP_ABS_MT_POSITION_X);
+		axes_labels[1] = XIGetKnownProperty(AXIS_LABEL_PROP_ABS_MT_POSITION_Y);
+		if (!InitPointerDeviceStruct(pDev, map, 1, btn_labels,
+					     (PtrCtrlProcPtr)NoopDDA,
+					     GetMotionHistorySize(), 2, axes_labels))
+			return BadAlloc;
+		InitValuatorAxisStruct(pDevice, 0, axes_labels[0], 0,
+				       VNC_TOUCH_AXIS_MAX, 1, 0, 1, Absolute);
+		InitValuatorAxisStruct(pDevice, 1, axes_labels[1], 0,
+				       VNC_TOUCH_AXIS_MAX, 1, 0, 1, Absolute);
+		if (!InitTouchClassDeviceStruct(pDevice, VNC_TOUCH_CONTACTS,
+						XIDirectTouch, 2))
+			return BadAlloc;
+		break;
+	case DEVICE_ON:
+		pDev->on = TRUE;
+		break;
+	case DEVICE_OFF:
+		pDev->on = FALSE;
+		break;
+	case DEVICE_CLOSE:
+		vncTouchDev = NULL;
+		break;
+	}
+
+	return Success;
+}
+
+static void vncInitTouchDevice(void)
+{
+	vncPointerDev->xinput_type = MakeAtom(XI_MOUSE, strlen(XI_MOUSE), TRUE);
+
+	vncTouchDev = AddInputDevice(serverClient, vncTouchProc, TRUE);
+	if (vncTouchDev == NULL)
+		FatalError("Failed to initialize TigerVNC touch device\n");
+	AssignTypeAndName(vncTouchDev,
+			  MakeAtom(XI_TOUCHSCREEN, strlen(XI_TOUCHSCREEN), TRUE),
+			  "TigerVNC touch");
+	vncTouchDev->public.processInputProc = ProcessOtherEvent;
+	vncTouchDev->public.realInputProc = ProcessOtherEvent;
+	vncTouchDev->deviceGrab.ActivateGrab = ActivatePointerGrab;
+	vncTouchDev->deviceGrab.DeactivateGrab = DeactivatePointerGrab;
+	vncTouchDev->coreEvents = TRUE;
+	vncTouchDev->spriteInfo->spriteOwner = FALSE;
+	vncTouchDev->type = SLAVE;
+
+	if (ActivateDevice(vncTouchDev, TRUE) != Success ||
+	    !EnableDevice(vncTouchDev, TRUE))
+		FatalError("Failed to activate TigerVNC touch device\n");
+
+	AttachDevice(NULL, vncTouchDev, inputInfo.pointer);
+}
+
+static double vncTouchAxis(int value, int size)
+{
+	double axis;
+
+	if (size < 1)
+		return 0;
+	axis = (double)value * (VNC_TOUCH_AXIS_MAX + 1) / size;
+	if (axis < 0)
+		return 0;
+	if (axis > VNC_TOUCH_AXIS_MAX)
+		return VNC_TOUCH_AXIS_MAX;
+	return axis;
+}
+
+void vncTouchEvent(int state, unsigned slot, int x, int y)
+{
+	static const int types[3] = { XI_TouchBegin, XI_TouchUpdate,
+				      XI_TouchEnd };
+	ValuatorMask mask;
+
+	if (vncTouchDev == NULL || !vncTouchDev->public.on)
+		return;
+	if (state < 0 || state > 2 || slot >= VNC_TOUCH_CONTACTS)
+		return;
+
+	/* Flush event queue to ensure we don't flood it */
+	mieqProcessInputEvents();
+
+	valuator_mask_zero(&mask);
+	valuator_mask_set_double(&mask, 0, vncTouchAxis(x, screenInfo.width));
+	valuator_mask_set_double(&mask, 1, vncTouchAxis(y, screenInfo.height));
+	/* DDX touch ids start at 1; slots are reused only after their end */
+	QueueTouchEvents(vncTouchDev, types[state], slot + 1, 0, &mask);
+}
